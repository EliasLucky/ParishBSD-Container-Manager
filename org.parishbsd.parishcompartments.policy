<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>ParishBSD</vendor>
  <vendor_url>https://parishbsd.org</vendor_url>

  <!--
    Fine-grained per-verb policy.

    Each action's exec.path is the per-verb binary installed at
    /usr/local/sbin/parishctl-<verb> (or dedicated helper). pkexec
    matches on the immediately-executed binary's path, so each verb
    gets its own action, its own prompt message, and its own cache policy.

    Cache policy:
      allow_active=yes           read-only verbs; no prompt on the
                                 active console (remote sessions refused
                                 via allow_inactive=no)
      auth_admin_keep            routine verbs; 5-minute cache
      auth_admin                 sensitive/destructive verbs; prompt every time

    Every action sets allow_any=no and allow_inactive=no so remote/inactive
    sessions cannot authorize privileged compartment actions.
  -->

  <!-- ================================================================ -->
  <!-- Read-only verbs (allow_active=yes: no console prompt)            -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.list">
    <description>List ParishBSD compartments</description>
    <message>Authentication is required to list compartments</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-list</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.show">
    <description>Show details for a ParishBSD compartment</description>
    <message>Authentication is required to inspect a compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-show</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-list">
    <description>List installed applications in a ParishBSD compartment</description>
    <message>Authentication is required to list installed applications</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-list</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.schedules">
    <description>List scheduled vault locks</description>
    <message>Authentication is required to list scheduled locks</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-schedules</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-list">
    <description>List ParishBSD templates</description>
    <message>Authentication is required to list templates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-list</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-show">
    <description>Show ParishBSD template details</description>
    <message>Authentication is required to inspect a template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-show</annotate>
  </action>

  <!-- ================================================================ -->
  <!-- Routine compartment lifecycle & policy verbs (auth_admin_keep)   -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.start">
    <description>Start a ParishBSD compartment</description>
    <message>Authentication is required to start the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-start</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.stop">
    <description>Stop a ParishBSD compartment</description>
    <message>Authentication is required to stop the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-stop</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.restart">
    <description>Restart a ParishBSD compartment</description>
    <message>Authentication is required to restart the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-restart</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.create">
    <description>Create a ParishBSD compartment</description>
    <message>Authentication is required to create a compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-create</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.lock">
    <description>Lock a ParishBSD vault</description>
    <message>Authentication is required to lock the vault</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-lock</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.set-risk">
    <description>Change the risk classification of a ParishBSD compartment</description>
    <message>Authentication is required to change the compartment risk level</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-set-risk</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.audio">
    <description>Configure sound and microphone access for a ParishBSD compartment</description>
    <message>Authentication is required to update compartment sound settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-audio</annotate>
  </action>

  <!-- ================================================================ -->
  <!-- Sensitive / destructive compartment verbs (auth_admin)           -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.destroy">
    <description>Destroy a ParishBSD compartment</description>
    <message>Authentication is required to destroy the compartment. This cannot be undone.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-destroy</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.unlock">
    <description>Unlock a ParishBSD vault</description>
    <message>Authentication is required to unlock the vault</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-unlock</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.console">
    <description>Open a shell in a ParishBSD compartment</description>
    <message>Authentication is required to open a console in the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-console</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.exchange">
    <description>Transfer files via ParishBSD File Exchange</description>
    <message>Authentication is required to transfer files between compartments or desktop quarantine</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-exchange</annotate>
  </action>

  <!-- ================================================================ -->
  <!-- Applications, launchers & display                                -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.create-launcher">
    <description>Create a shortcut for an application in a ParishBSD compartment</description>
    <message>Authentication is required to create an application shortcut</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parish-app-create-launcher</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-install">
    <description>Install a FreeBSD package in a ParishBSD compartment</description>
    <message>Authentication is required to install an application in the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-install</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-install-file">
    <description>Install an application from a file in a ParishBSD compartment</description>
    <message>Authentication is required to install an application from a file in the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-install-file</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-remove">
    <description>Remove a FreeBSD package from a ParishBSD compartment</description>
    <message>Authentication is required to remove a package from the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-remove</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-remove-custom">
    <description>Remove a custom application from a ParishBSD compartment</description>
    <message>Authentication is required to remove a custom application from the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-remove-custom</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.apps-upgrade">
    <description>Upgrade packages in a ParishBSD compartment</description>
    <message>Authentication is required to update applications in the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-apps-upgrade</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.run-in-jail">
    <description>Run an application in a ParishBSD compartment</description>
    <message>Authentication is required to run an application in the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parish-jail-run</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.xpra-start">
    <description>Start graphical display session for a ParishBSD compartment</description>
    <message>Authentication is required to start the display session for the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-xpra-start</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.xpra-stop">
    <description>Stop graphical display session for a ParishBSD compartment</description>
    <message>Authentication is required to stop the display session for the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-xpra-stop</annotate>
  </action>

  <!-- ================================================================ -->
  <!-- Schedules & USB                                                  -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.schedule-lock">
    <description>Schedule a daily lock for a ParishBSD vault</description>
    <message>Authentication is required to schedule a vault lock</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-schedule-lock</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.unschedule-lock">
    <description>Remove a scheduled lock for a ParishBSD vault</description>
    <message>Authentication is required to remove a scheduled vault lock</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-unschedule-lock</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.usb-attach">
    <description>Attach a USB device to a ParishBSD compartment</description>
    <message>Authentication is required to attach a removable drive to the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-usb-attach</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.usb-detach">
    <description>Detach a USB device from a ParishBSD compartment</description>
    <message>Authentication is required to detach a removable drive from the compartment</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-usb-detach</annotate>
  </action>

  <!-- ================================================================ -->
  <!-- Template verbs                                                   -->
  <!-- ================================================================ -->

  <action id="org.parishbsd.parishcompartments.template-create">
    <description>Create a ParishBSD template</description>
    <message>Authentication is required to create a template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-create</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-destroy">
    <description>Destroy a ParishBSD template</description>
    <message>Authentication is required to destroy the template. This cannot be undone.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-destroy</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-kill">
    <description>Cancel a running template build</description>
    <message>Authentication is required to cancel a template build</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-kill</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-scrub">
    <description>Clean up orphaned template data</description>
    <message>Authentication is required to clean up templates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-scrub</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-hide">
    <description>Hide a ParishBSD template</description>
    <message>Authentication is required to hide the template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-hide</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-unhide">
    <description>Unhide a ParishBSD template</description>
    <message>Authentication is required to unhide the template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-unhide</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-rename">
    <description>Rename a ParishBSD template</description>
    <message>Authentication is required to rename the template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-rename</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-reset">
    <description>Reset a shipped ParishBSD template override</description>
    <message>Authentication is required to reset the template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parishctl-template-reset</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-build">
    <description>Build or update a ParishBSD template</description>
    <message>Authentication is required to build or update the template</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/parish-template-build</annotate>
  </action>

  <action id="org.parishbsd.parishcompartments.template-wizard">
    <description>Run the ParishBSD template creation wizard</description>
    <message>Authentication is required to run the template wizard</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/parish-template-wizard</annotate>
  </action>

</policyconfig>

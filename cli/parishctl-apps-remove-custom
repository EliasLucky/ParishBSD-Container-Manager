#!/bin/sh
# parishctl-apps-remove-custom  remove a custom app's metadata.
#
# Runs via pkexec. Polkit action .apps-remove-custom at auth_admin_keep.
#
# Refuses on containment states.
#
# Note: parish-apps remove-custom unlinks BOTH host-side metadata
# and legacy in-jail metadata by name. The
# jail is not required to be running for either unlink.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -ne 2 ]; then
    printf 'usage: parishctl apps remove-custom <jail> <app>\n' >&2
    exit 2
fi

jail="$1"
app="$2"

validate_jail_name_existing "$jail" || exit 2
validate_app_name "$app" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained)
        : # proceed
        ;;
    stopped)
        printf 'parishctl: compartment "%s" is not running.\n' "$jail" >&2
        printf 'Start it first:\n  pkexec parishctl-start %s\n' "$jail" >&2
        exit 1
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

exec /usr/local/bin/parish-apps remove-custom "$jail" "$app"
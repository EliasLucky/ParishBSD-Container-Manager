#!/bin/sh
# parishctl-apps-remove-custom  remove a custom app's metadata.
#
# Runs via pkexec. Polkit action .apps-remove-custom at auth_admin_keep.
#
# Refuses on containment states (a contained jail should not have
# its files modified until the incident is reviewed).
#
# Allows stopped jails. The underlying `parish-apps remove-custom`
# operates on files: host-side metadata at
# /var/db/parishbsd/launchers/<jail>/<slug>.conf and legacy in-jail
# metadata at
# /usr/local/jails/<tier>/<jail>/usr/local/etc/parishbsd/custom-apps/<slug>.conf

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -ne 2 ]; then
    printf 'usage: parishctl apps remove-custom <jail> <app>\n' >&2
    exit 2
fi

jail="$1"
app="$2"

validate_jail_name_existing "$jail" || exit 2
validate_app_name "$app" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained|stopped)
        : # proceed — filesystem operations work on stopped jails
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

exec /usr/local/bin/parish-apps remove-custom "$jail" "$app"
#!/bin/sh
# parishctl-list - List containers (JSON)
set -eu

PATH=/usr/local/bin:/usr/local/sbin:/bin:/sbin:/usr/bin:/usr/sbin
export PATH

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/state.sh"

json_mode=0
while [ $# -gt 0 ]; do
    case "$1" in
        --json) json_mode=1 ;;
        *) echo "parish: unknown flag $1" >&2; exit 2 ;;
    esac
    shift
done

if [ "$json_mode" -eq 1 ]; then
    printf '[\n'
else
    printf "%-20s %-15s %-15s %-15s\n" "NAME" "KIND" "STATE" "TEMPLATE"
    printf "%-20s %-15s %-15s %-15s\n" "----" "----" "-----" "--------"
fi

first=1
for d in /usr/local/jails/app/* /usr/local/jails/vault/*; do
    [ -d "$d" ] || continue
    [ -f "$d/bin/sh" ] || continue
    
    name=$(basename "$d")
    tier=$(basename "$(dirname "$d")")
    is_vault=0
    [ "$tier" = "vault" ] && is_vault=1
    
    # JSON escape name
    name_esc=$(printf '%s' "$name" | sed 's/["\\]/\\&/g')
    
    state=$(parish_jail_state "$name")
    
    key_state="null"
    if [ "$is_vault" -eq 1 ]; then
        ds="zroot/vault-data/$name"
        ks=$(/sbin/zfs get -H -o value keystatus "$ds" 2>/dev/null || echo "unavailable")
        if [ "$ks" = "available" ]; then
            key_state='"unlocked"'
        else
            key_state='"locked"'
        fi
    fi
    
    # Use mountpoint $d to find dataset usage
    ds_used=$(/sbin/zfs get -H -o value used "$d" 2>/dev/null || echo "0")
    bytes=$(echo "$ds_used" | awk '
        /^[0-9]+$/ { print $1; exit }
        /K$/ { sub(/K/,""); print $1 * 1024; exit }
        /M$/ { sub(/M/,""); print $1 * 1024 * 1024; exit }
        /G$/ { sub(/G/,""); print $1 * 1024 * 1024 * 1024; exit }
        /T$/ { sub(/T/,""); print $1 * 1024 * 1024 * 1024 * 1024; exit }
        { print 0 }
    ')
    [ -z "$bytes" ] && bytes=0
    
    source_template=""
    meta="/var/db/parishbsd/compartments/$name/metadata.conf"
    if [ -f "$meta" ]; then
        source_template=$(grep '^source_template=' "$meta" 2>/dev/null | cut -d= -f2 || true)
    fi
    # T4b-S2: JSON escape source_template
    st_esc=$(printf '%s' "$source_template" | sed 's/["\\]/\\&/g')
    
    kind="Container"
    case "$source_template" in
        vault-files*) kind="File Vault" ;;
        vault-postgres*) kind="Database Vault" ;;
        apps-compat-*) kind="Compatibility" ;;
        apps|browser-*) kind="Application" ;;
    esac
    
    if [ "$json_mode" -eq 1 ]; then
        [ "$first" -eq 1 ] || printf ',\n'
        first=0
        printf '  {\n'
        printf '    "name": "%s",\n' "$name_esc"
        printf '    "jail_state": "%s",\n' "$state"
        printf '    "key_state": %s,\n' "$key_state"
        printf '    "source_template": "%s",\n' "$st_esc"
        printf '    "kind": "%s",\n' "$kind"
        printf '    "tier": "%s",\n' "$tier"
        printf '    "disk_usage": %s,\n' "$bytes"
        printf '    "is_vault": %s,\n' "$([ "$is_vault" -eq 1 ] && echo "true" || echo "false")"
        printf '    "is_compatibility": %s\n' "$(echo "$source_template" | grep -q "^apps-compat" && echo "true" || echo "false")"
        printf '  }'
    else
        printf "%-20s %-15s %-15s %-15s\n" "$name" "$kind" "$state" "${source_template:-Unknown}"
    fi
done

if [ "$json_mode" -eq 1 ]; then
    printf '\n]\n'
fi
#!/bin/sh
# parishctl-list  list compartments (text or JSON).
set -eu

PATH=/usr/local/bin:/usr/local/sbin:/bin:/sbin:/usr/bin:/usr/sbin
export PATH

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"
. "$LIBDIR/policy.sh"
. "$LIBDIR/os_upgrade.sh"

host_os_ver="$(parish_host_os_version)"
host_os_arch="$(parish_host_os_arch)"
host_os_ver_esc=$(printf '%s' "$host_os_ver" | sed 's/["\\]/\\&/g')
host_os_arch_esc=$(printf '%s' "$host_os_arch" | sed 's/["\\]/\\&/g')

json_mode=0
while [ $# -gt 0 ]; do
    case "$1" in
        --json) json_mode=1 ;;
        *) echo "parish: unknown flag $1" >&2; exit 2 ;;
    esac
    shift
done

if [ "$json_mode" -eq 1 ]; then
    printf '[\n'
else
    printf "%-18s %-15s %-12s %-10s %-18s %-14s\n" "NAME" "KIND" "STATE" "RISK" "OS_VERSION" "TEMPLATE"
    printf "%-18s %-15s %-12s %-10s %-18s %-14s\n" "----" "----" "-----" "----" "----------" "--------"
fi

read_meta() {
    _rm_root="$1"
    _rm_key="$2"
    _rm_m="$_rm_root/usr/local/etc/parishbsd/metadata"
    [ -f "$_rm_m" ] && [ ! -L "$_rm_m" ] || return 0
    awk -F= -v k="$_rm_key" '$1==k { sub(/^[^=]*=/,""); print; exit }' "$_rm_m" 2>/dev/null
}

first=1
for d in /usr/local/jails/app/* /usr/local/jails/vault/* /usr/local/jails/containers/*; do
    [ -d "$d" ] || continue
    [ -f "$d/bin/sh" ] || continue

    name=$(basename "$d")

    tier=$(read_meta "$d" TIER)
    source_template=$(read_meta "$d" SOURCE_TEMPLATE)
    meta_kind=$(read_meta "$d" KIND)

    case "${tier:-}" in
        app|vault) : ;;
        *)
            case "$(basename "$(dirname "$d")")" in
                vault) tier="vault" ;;
                app)   tier="app" ;;
                *)     tier="unknown" ;;
            esac
            ;;
    esac

    is_vault=0
    [ "$tier" = "vault" ] && is_vault=1

    name_esc=$(printf '%s' "$name" | sed 's/["\\]/\\&/g')

    state=$(parish_jail_state "$name")

    key_state="null"
    if [ "$is_vault" -eq 1 ]; then
        ds="zroot/vault-data/$name"
        ks=$(/sbin/zfs get -H -o value keystatus "$ds" 2>/dev/null || echo "unavailable")
        if [ "$ks" = "available" ]; then
            key_state='"unlocked"'
        else
            key_state='"locked"'
        fi
    fi

    ds_used=$(/sbin/zfs get -H -o value used "$d" 2>/dev/null || echo "0")
    bytes=$(echo "$ds_used" | awk '
        /^[0-9]+$/ { print $1; exit }
        /K$/ { sub(/K/,""); print $1 * 1024; exit }
        /M$/ { sub(/M/,""); print $1 * 1024 * 1024; exit }
        /G$/ { sub(/G/,""); print $1 * 1024 * 1024 * 1024; exit }
        /T$/ { sub(/T/,""); print $1 * 1024 * 1024 * 1024 * 1024; exit }
        { print 0 }
    ')
    [ -z "$bytes" ] && bytes=0

    st_esc=$(printf '%s' "$source_template" | sed 's/["\\]/\\&/g')

    case "${meta_kind:-}" in
        application)    kind="Application" ;;
        file-vault)     kind="File Vault" ;;
        database-vault) kind="Database Vault" ;;
        *)
            case "$source_template" in
                vault-files*|vault-postgres*) kind="Vault" ;;
                apps-compat*)                 kind="Compatibility" ;;
                *)                            kind="Application" ;;
            esac
            [ "$is_vault" -eq 1 ] && [ "$kind" = "Application" ] && kind="Vault"
            ;;
    esac

    risk_level=$(parish_container_risk "$name" "$tier")
    audio_pol=$(parish_audio_policy_get "$name" "$tier")
    audio_out="${audio_pol%% *}"
    audio_in="${audio_pol##* }"
    caps_space=$(parish_container_capabilities "$d" "$tier" "$source_template")
    is_compat="false"
    case " $caps_space " in
        *" compat-linux "*|*" compat-windows "*) is_compat="true" ;;
    esac

    caps_json=""
    for _c in $caps_space; do
        _ce=$(printf '%s' "$_c" | sed 's/["\\]/\\&/g')
        caps_json="${caps_json:+$caps_json, }\"$_ce\""
    done

    comp_os_ver="$(parish_root_os_version "$d" || echo "unknown")"
    comp_os_arch="$(parish_root_os_arch "$d" || echo "$host_os_arch")"
    comp_os_status="$(parish_version_status "$comp_os_ver" "$host_os_ver")"
    comp_needs_rec="false"
    if parish_upgrade_interrupted "$name"; then
        comp_needs_rec="true"
    fi
    comp_os_ver_esc=$(printf '%s' "$comp_os_ver" | sed 's/["\\]/\\&/g')
    comp_os_arch_esc=$(printf '%s' "$comp_os_arch" | sed 's/["\\]/\\&/g')

    if [ "$json_mode" -eq 1 ]; then
        [ "$first" -eq 1 ] || printf ',\n'
        first=0
        printf '  {\n'
        printf '    "name": "%s",\n' "$name_esc"
        printf '    "jail_state": "%s",\n' "$state"
        printf '    "key_state": %s,\n' "$key_state"
        printf '    "source_template": "%s",\n' "$st_esc"
        printf '    "kind": "%s",\n' "$kind"
        printf '    "tier": "%s",\n' "$tier"
        printf '    "risk_level": "%s",\n' "$risk_level"
        printf '    "capabilities": [%s],\n' "$caps_json"
        printf '    "audio_output": %s,\n' "$([ "$audio_out" = "1" ] && echo "true" || echo "false")"
        printf '    "audio_input": %s,\n' "$([ "$audio_in" = "1" ] && echo "true" || echo "false")"
        printf '    "disk_usage": %s,\n' "$bytes"
        printf '    "is_vault": %s,\n' "$([ "$is_vault" -eq 1 ] && echo "true" || echo "false")"
        printf '    "is_compatibility": %s,\n' "$is_compat"
        printf '    "os_version": "%s",\n' "$comp_os_ver_esc"
        printf '    "os_arch": "%s",\n' "$comp_os_arch_esc"
        printf '    "host_os_version": "%s",\n' "$host_os_ver_esc"
        printf '    "host_os_arch": "%s",\n' "$host_os_arch_esc"
        printf '    "os_status": "%s",\n' "$comp_os_status"
        printf '    "needs_recovery": %s\n' "$comp_needs_rec"
        printf '  }'
    else
        printf "%-18s %-15s %-12s %-10s %-18s %-14s\n" "$name" "$kind" "$state" "$risk_level" "$comp_os_ver" "${source_template:-Unknown}"
    fi
done

if [ "$json_mode" -eq 1 ]; then
    printf '\n]\n'
fi

#!/bin/sh
# parish-usb  attach/detach/list removable media for compartments.
#
# Security Philosophy:
#   - Default mount mode is READ-ONLY (-o ro,nosuid,noexec,nodev) to prevent
#     malware inside an untrusted compartment from modifying, wiping, or
#     infecting a physical USB drive used across other computers.
#   - Read-Write (--rw / --read-write) is supported so legitimate workflows
#     (e.g. exporting parish PDFs to a printer USB stick) are not blocked,
#     but REQUIRES explicit user permission (--confirm-rw or interactive
#     confirmation) and is strictly refused if already mounted elsewhere or
#     for read-only optical media.
#   - Host system/boot/zroot disks are unconditionally excluded.
#
# Usage:
#   parish-usb list [--json]
#   parish-usb devices [--json]
#   parish-usb attach <jail> <dev> [fstype] [--ro|--rw] [--confirm-rw]
#   parish-usb detach <jail> <dev>

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"
. "$LIBDIR/service.sh"
. "$LIBDIR/container.sh"
. "$LIBDIR/policy.sh"

HOST_MNT_ROOT="/var/parishbsd/media"
JAIL_MNT_SUBDIR="media"
ALLOWED_FS="msdosfs ufs cd9660 exfat ntfs"

log() { logger -t parish-usb -p user.info -- "$*" 2>/dev/null || true; }
err() { logger -t parish-usb -p user.err -- "$*" 2>/dev/null || true; \
        echo "parish-usb: $*" >&2; exit 1; }
require_root() { [ "$(id -u)" -eq 0 ] || err "must be run as root"; }

validate_dev() {
    case "$1" in
        */*|*..*) err "invalid device name: '$1'" ;;
        da[0-9]*|cd[0-9]*)
            case "$1" in
                *[!A-Za-z0-9]*) err "invalid characters in device name: '$1'" ;;
            esac
            return 0
            ;;
        *) err "invalid device name: '$1' (expected da[0-9]* or cd[0-9]*)" ;;
    esac
}

base_disk_of() {
    printf '%s' "$1" | sed -E 's/^((da|cd)[0-9]+).*/\1/'
}

is_host_system_disk() {
    local dev="$1"
    local bdisk
    bdisk="$(base_disk_of "$dev")"
    [ -n "$bdisk" ] || return 0

    # Check if backing any host system mountpoints
    if mount -p 2>/dev/null | awk '$2 == "/" || $2 == "/usr" || $2 == "/var" || $2 == "/boot" { print $1 }' \
        | grep -Eq "(^|/)${bdisk}([ps][0-9]+)?([a-z])?\$"; then
        return 0
    fi

    # Check if backing any active ZFS pool (e.g. zroot)
    if command -v zpool >/dev/null 2>&1; then
        if zpool status 2>/dev/null | grep -Eq "\\b${bdisk}([ps][0-9]+)?([a-z])?\\b"; then
            return 0
        fi
    fi

    return 1
}

validate_fs() {
    for fs in $ALLOWED_FS; do
        [ "$1" = "$fs" ] && return 0
    done
    err "unsupported filesystem: '$1' (allowed: $ALLOWED_FS)"
}

ensure_dir() {
    local path="$1" parent="$2"
    local parent_real
    parent_real=$(realpath "$parent") || err "cannot resolve parent: $parent"
    [ "$parent_real" = "$parent" ] \
        || err "parent is not canonical: $parent -> $parent_real"
    [ ! -L "$path" ] || err "path is a symlink: $path"
    if [ ! -d "$path" ]; then
        mkdir -p "$path" || err "cannot create $path"
    fi
    [ ! -L "$path" ] || err "path became a symlink: $path"
    case "$path" in
        "$parent"/*) ;;
        *) err "path escapes parent: $path" ;;
    esac
}

resolve_jail_root() {
    local jail="$1"
    validate_jail_name_existing "$jail"
    local d
    for tier in app vault containers; do
        d="/usr/local/jails/$tier/$jail"
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    err "jail not found: $jail"
}

validate_jail_root() {
    local jr="$1" real
    [ ! -L "$jr" ] || err "jail root is a symlink: $jr"
    real=$(realpath "$jr") || err "cannot resolve jail root: $jr"
    [ "$real" = "$jr" ] || err "jail root not canonical: $jr -> $real"
}

is_mounted() {
    mount -p | cut -f2 | grep -qxF "$1"
}

_mount_opts_for() {
    mount -p | awk -F'\t' -v m="$1" '$2 == m { print $4; exit }'
}

_attached_jails_for_dev() {
    local dev="$1" out="" tier jr jm
    for jr in /usr/local/jails/app/* /usr/local/jails/vault/* /usr/local/jails/containers/*; do
        [ -d "$jr" ] || continue
        jm="$jr/$JAIL_MNT_SUBDIR/$dev"
        if is_mounted "$jm"; then
            out="${out:+$out,}$(basename "$jr")"
        fi
    done
    printf '%s' "$out"
}

cmd_list() {
    local json_mode=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json_mode=1 ;;
            *) err "unknown flag: $1" ;;
        esac
        shift
    done

    if [ "$json_mode" -eq 1 ]; then
        printf '[\n'
        first=1
        for dir in "$HOST_MNT_ROOT"/*; do
            [ -d "$dir" ] || continue
            [ ! -L "$dir" ] || continue
            dev=$(basename "$dir")
            if is_mounted "$dir"; then
                src=$(mount -p | awk -F'\t' -v m="$dir" '$2 == m { print $1; exit }')
                fstype=$(mount -p | awk -F'\t' -v m="$dir" '$2 == m { print $3; exit }')
                mopts=$(_mount_opts_for "$dir")
                mode="ro"
                case ",$mopts," in *,rw,*) mode="rw" ;; esac
                jails="$(_attached_jails_for_dev "$dev")"
                [ "$first" -eq 1 ] || printf ',\n'
                first=0
                printf '  {"device": "%s", "source": "%s", "fstype": "%s", "mode": "%s", "attached_jails": "%s"}' \
                    "$dev" "$src" "$fstype" "$mode" "$jails"
            fi
        done
        printf '\n]\n'
        return 0
    fi

    echo "Attached devices:"
    for dir in "$HOST_MNT_ROOT"/*; do
        [ -d "$dir" ] || continue
        [ -L "$dir" ] && continue
        dev=$(basename "$dir")
        if is_mounted "$dir"; then
            mopts=$(_mount_opts_for "$dir")
            mode="ro"
            case ",$mopts," in *,rw,*) mode="rw" ;; esac
            jails="$(_attached_jails_for_dev "$dev")"
            printf "  %-10s  %-4s  %s\n" "$dev" "$mode" "${jails:-<host-only>}"
        else
            printf "  %-10s  %-4s  %s\n" "$dev" "-" "<not mounted>"
        fi
    done
}

cmd_devices() {
    local json_mode=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json_mode=1 ;;
            *) err "unknown flag: $1" ;;
        esac
        shift
    done

    if [ "$json_mode" -eq 1 ]; then
        printf '[\n'
    else
        printf "%-10s %-10s %-8s %-10s %s\n" "DEVICE" "FSTYPE" "MODE" "SIZE" "ATTACHED TO"
    fi

    first=1
    for devpath in /dev/da[0-9]* /dev/cd[0-9]*; do
        [ -e "$devpath" ] || continue
        dev="$(basename "$devpath")"
        case "$dev" in *[!A-Za-z0-9]*) continue ;; esac
        # Skip raw whole-disk da0 if partition slices like da0p1 or da0s1 exist
        case "$dev" in
            da[0-9]|da[0-9][0-9])
                has_parts=0
                for _p in "/dev/${dev}p"* "/dev/${dev}s"*; do
                    [ -e "$_p" ] && { has_parts=1; break; }
                done
                [ "$has_parts" -eq 1 ] && continue
                ;;
        esac
        if is_host_system_disk "$dev"; then
            continue
        fi

        fstype="$(fstyp "$devpath" 2>/dev/null || echo "")"
        bytes="$(diskinfo "$devpath" 2>/dev/null | awk '{print $3; exit}' || echo 0)"
        [ -n "$bytes" ] || bytes=0
        hmnt="$HOST_MNT_ROOT/$dev"
        attached_jails="$(_attached_jails_for_dev "$dev")"
        mode="unmounted"
        if is_mounted "$hmnt"; then
            mopts=$(_mount_opts_for "$hmnt")
            mode="ro"
            case ",$mopts," in *,rw,*) mode="rw" ;; esac
        fi

        if [ "$json_mode" -eq 1 ]; then
            [ "$first" -eq 1 ] || printf ',\n'
            first=0
            printf '  {"device": "%s", "fstype": "%s", "size": %s, "mode": "%s", "attached_jails": "%s"}' \
                "$dev" "$fstype" "$bytes" "$mode" "$attached_jails"
        else
            printf "%-10s %-10s %-8s %-10s %s\n" "$dev" "${fstype:-unknown}" "$mode" "$bytes" "${attached_jails:--}"
        fi
    done

    if [ "$json_mode" -eq 1 ]; then
        printf '\n]\n'
    fi
}

cmd_attach() {
    [ $# -ge 2 ] || err "usage: parish-usb attach <jail> <dev> [fstype] [--ro|--rw] [--confirm-rw]"
    local jail="$1" dev="$2"
    shift 2

    local fstype="" req_mode="ro" confirm_rw=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --ro|--read-only)   req_mode="ro" ;;
            --rw|--read-write)  req_mode="rw" ;;
            --confirm-rw)       confirm_rw=1 ;;
            -*)                 err "unknown flag: $1" ;;
            *)
                if [ -z "$fstype" ]; then fstype="$1"
                else err "unexpected argument: $1"
                fi
                ;;
        esac
        shift
    done

    require_root
    validate_dev "$dev"

    if is_host_system_disk "$dev"; then
        err "refusing to attach host system/ZFS pool disk: /dev/$dev"
    fi

    # Containment state check.
    state="$(parish_jail_state "$jail")"
    case "$state" in
        running|running-other-contained|stopped)
            : # proceed
            ;;
        *)
            parish_jail_state_message "$jail" "$state" >&2
            exit 1
            ;;
    esac

    local dev_path="/dev/$dev"
    [ -c "$dev_path" ] || [ -b "$dev_path" ] || err "not a storage device: $dev_path"

    if [ "$req_mode" = "rw" ]; then
        case "$dev" in
            cd[0-9]*) err "optical device $dev cannot be mounted read-write" ;;
        esac
        if [ "$confirm_rw" -ne 1 ]; then
            if [ -t 0 ]; then
                printf 'WARNING: Attaching /dev/%s READ-WRITE to "%s" lets the compartment modify or erase the drive.\n' "$dev" "$jail" >&2
                printf 'Confirm read-write mount? [y/N]: ' >&2
                read -r _ans
                case "$_ans" in
                    y|Y|yes|YES) : ;;
                    *) err "read-write mount cancelled by user" ;;
                esac
            else
                err "read-write USB attach requires explicit permission (--confirm-rw). Default mount is read-only."
            fi
        fi
    fi

    local jail_root
    jail_root=$(resolve_jail_root "$jail")
    validate_jail_root "$jail_root"

    if [ -z "$fstype" ]; then
        fstype=$(fstyp "$dev_path" 2>/dev/null) \
            || err "cannot determine filesystem of $dev_path (specify explicitly)"
    fi
    validate_fs "$fstype"

    if [ "$fstype" = "cd9660" ] && [ "$req_mode" = "rw" ]; then
        err "cd9660 filesystem is read-only"
    fi

    case "$fstype" in
        exfat)
            command -v mount.exfat >/dev/null 2>&1 \
                || err "exfat support requires sysutils/fusefs-exfat (pkg install fusefs-exfat)"
            ;;
        ntfs)
            command -v mount.ntfs >/dev/null 2>&1 \
                || err "ntfs support requires sysutils/fusefs-ntfs (pkg install fusefs-ntfs)"
            ;;
    esac

    ensure_dir "$HOST_MNT_ROOT" "/var/parishbsd"
    ensure_dir "$HOST_MNT_ROOT/$dev" "$HOST_MNT_ROOT"
    ensure_dir "$jail_root/$JAIL_MNT_SUBDIR" "$jail_root"
    ensure_dir "$jail_root/$JAIL_MNT_SUBDIR/$dev" "$jail_root/$JAIL_MNT_SUBDIR"

    local host_mnt="$HOST_MNT_ROOT/$dev"
    local jail_mnt="$jail_root/$JAIL_MNT_SUBDIR/$dev"
    local mount_opts="${req_mode},nosuid,noexec,nodev"

    _host_mount_created=0
    if is_mounted "$host_mnt"; then
        local existing_opts existing_mode
        existing_opts="$(_mount_opts_for "$host_mnt")"
        existing_mode="ro"
        case ",$existing_opts," in *,rw,*) existing_mode="rw" ;; esac
        if [ "$req_mode" = "rw" ] || [ "$existing_mode" = "rw" ]; then
            err "$dev is already mounted ($existing_mode); detach before remounting read-write or sharing"
        fi
        log "host side already mounted read-only: $dev -> $host_mnt"
    else
        mount -t "$fstype" -o "$mount_opts" "$dev_path" "$host_mnt" \
            || err "cannot mount $dev_path on $host_mnt ($mount_opts)"
        _host_mount_created=1
        log "mounted $dev_path -> $host_mnt ($fstype, $mount_opts)"
    fi

    if is_mounted "$jail_mnt"; then
        log "jail side already exposed: $host_mnt -> $jail_mnt"
    else
        if ! mount_nullfs -o "$mount_opts" "$host_mnt" "$jail_mnt"; then
            if [ "$_host_mount_created" -eq 1 ]; then
                umount "$host_mnt" 2>/dev/null || true
                log "rolled back host mount after jail-mount failure: $host_mnt"
            fi
            err "cannot expose $host_mnt inside jail $jail"
        fi
        log "exposed $host_mnt -> $jail_mnt (jail: $jail, $mount_opts)"
    fi

    echo "Attached: $dev ($fstype, $req_mode) -> $jail:/$JAIL_MNT_SUBDIR/$dev"
}

cmd_detach() {
    [ $# -eq 2 ] || err "usage: parish-usb detach <jail> <dev>"
    local jail="$1" dev="$2"
    require_root
    validate_dev "$dev"

    state="$(parish_jail_state "$jail")"
    case "$state" in
        running|running-other-contained|stopped)
            : # proceed
            ;;
        *)
            parish_jail_state_message "$jail" "$state" >&2
            exit 1
            ;;
    esac

    local jail_root
    jail_root=$(resolve_jail_root "$jail")
    validate_jail_root "$jail_root"

    local jail_mnt="$jail_root/$JAIL_MNT_SUBDIR/$dev"
    local host_mnt="$HOST_MNT_ROOT/$dev"

    if is_mounted "$jail_mnt"; then
        umount "$jail_mnt" \
            || err "cannot unmount $jail_mnt (device busy?)"
        log "unmounted $jail_mnt"
    else
        log "not mounted (jail): $jail_mnt"
    fi

    # Unmount host side only if no other jail still references this device
    local remaining
    remaining="$(_attached_jails_for_dev "$dev")"
    if [ -z "$remaining" ] && is_mounted "$host_mnt"; then
        umount "$host_mnt" \
            || err "cannot unmount $host_mnt (device busy?)"
        log "unmounted $host_mnt"
    elif [ -n "$remaining" ]; then
        log "keeping host mount $host_mnt (still attached to: $remaining)"
    fi

    [ -d "$jail_mnt" ] && [ ! -L "$jail_mnt" ] && rmdir "$jail_mnt" 2>/dev/null || true
    if [ -z "$remaining" ]; then
        [ -d "$host_mnt" ] && [ ! -L "$host_mnt" ] && rmdir "$host_mnt" 2>/dev/null || true
    fi

    echo "Detached: $dev from $jail"
}

main() {
    [ $# -ge 1 ] || err "usage: parish-usb {list|devices|attach|detach} ..."
    cmd="$1"; shift
    case "$cmd" in
        list)    cmd_list "$@" ;;
        devices) cmd_devices "$@" ;;
        attach)  cmd_attach "$@" ;;
        detach)  cmd_detach "$@" ;;
        *)       err "unknown subcommand: $cmd" ;;
    esac
}

main "$@"

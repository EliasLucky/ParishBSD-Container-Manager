#!/bin/sh
# parishctl-set-risk  set visual risk classification for a compartment.
#
# Usage: parishctl-set-risk <jail> <low|medium|high|critical>
# Runs as root via pkexec.
#
# Risk levels live host-side under /var/db/parishbsd/risk/<jail> (0644,
# root:wheel), invisible inside jails so a compromised compartment cannot
# spoof its own border color or trust badge.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"
. "$LIBDIR/service.sh"
. "$LIBDIR/container.sh"
. "$LIBDIR/policy.sh"

if [ "$#" -ne 2 ]; then
    printf 'usage: parishctl set-risk <jail> <low|medium|high|critical>\n' >&2
    exit 2
fi

jail="$1"
risk="$2"

validate_jail_name_existing "$jail" || exit 2
jailroot="$(container_path "$jail")" || {
    printf 'parishctl: no compartment named "%s"\n' "$jail" >&2
    exit 1
}

parish_require_not_contained "$jail" || exit 1

norm_risk="$(parish_normalize_risk "$risk")" || {
    printf 'parishctl: invalid risk level "%s" (expected low, medium, high, or critical)\n' "$risk" >&2
    exit 2
}

tier="$(container_tier "$jailroot")"
if [ "$tier" = "vault" ] && [ "$norm_risk" != "critical" ]; then
    printf 'parishctl: note: "%s" is an encrypted vault; visual risk level updated to "%s".\n' \
        "$jail" "$norm_risk" >&2
fi

parish_set_risk_file "$jail" "$norm_risk" || {
    printf 'parishctl: failed to save risk level for "%s"\n' "$jail" >&2
    exit 1
}

printf 'Risk level for "%s" set to %s.\n' "$jail" "$norm_risk"

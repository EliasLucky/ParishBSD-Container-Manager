#!/bin/sh
# parishctl-xpra-stop  stop Xpra display server and supervisor for a compartment.
# Runs via pkexec.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    printf 'usage: parishctl xpra stop <jail> [<display>]\n' >&2
    exit 2
fi

jail="$1"
validate_jail_name_existing "$jail" || exit 2

exec /usr/local/bin/parish-xpra stop "$jail" "$@"

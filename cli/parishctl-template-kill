#!/bin/sh
set -eu
name="${1:?usage: parishctl template kill <name>}"
pid_file="/var/run/parishbsd/template-build-$name.pid"

[ -f "$pid_file" ] || { echo "parish: no build running for '$name'" >&2; exit 1; }
pid=$(cat "$pid_file" 2>/dev/null)
case "$pid" in ''|*[!0-9]*) echo "parish: pid file corrupt" >&2; exit 1 ;; esac

if ! ps -p "$pid" -o comm= 2>/dev/null | grep -q '^parish-template-build$'; then
    echo "parish: pid $pid is not a running template build." >&2
    echo "        Run 'parishctl template scrub' to clean up." >&2; exit 1
fi

pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
echo "Sending SIGTERM to process group $pgid..."
kill -TERM -"$pgid"

for i in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
if kill -0 "$pid" 2>/dev/null; then
    echo "parish: build did not exit within 5s; sending SIGKILL..." >&2
    kill -KILL -"$pgid"
    for i in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
fi
echo "Build cancelled."
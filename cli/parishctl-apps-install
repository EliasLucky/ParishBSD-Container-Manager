#!/bin/sh
# parishctl-apps-install  install a FreeBSD package from the catalog.
#
# Runs via pkexec. Polkit action .apps-install at auth_admin_keep
# (5-minute cache; reversible by parishctl-apps-remove).
#
# Refuses on containment states. Refuses on stopped jail with a
# named recovery. Validates the jail name and package name before
# the containment check so an invalid input never reaches the state
# probe (which runs subprocesses).

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -ne 2 ]; then
    printf 'usage: parishctl apps install <jail> <package>\n' >&2
    exit 2
fi

jail="$1"
package="$2"

validate_jail_name_existing "$jail" || exit 2
validate_package_name "$package" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained)
        : # proceed
        ;;
    stopped)
        printf 'parishctl: compartment "%s" is not running.\n' "$jail" >&2
        printf 'Start it first:\n  pkexec parishctl-start %s\n' "$jail" >&2
        exit 1
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

exec /usr/local/bin/parish-apps install "$jail" "$package"
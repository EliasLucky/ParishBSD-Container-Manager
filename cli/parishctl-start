#!/bin/sh
# parishctl-start — start a compartment.
#
# Runs via pkexec. Polkit action .start at auth_admin_keep.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib

. "$LIBDIR/validate.sh"
. "$LIBDIR/container.sh"
. "$LIBDIR/state.sh"
. "$LIBDIR/service.sh"

if [ "$#" -ne 1 ]; then
    printf 'usage: parishctl start <name>\n' >&2
    exit 2
fi

name="$1"
validate_jail_name_existing "$name" || exit 2

container_start "$name"
#!/bin/sh
# parishctl-apps-install-file  install an application from a file.
#
# Runs via pkexec. Polkit action .apps-install-file at auth_admin
# (no cache; arbitrary file installation is higher-risk than catalog
# install).
#
# Flags pass through unchanged (--mode=, --launcher=). The underlying
# parish-apps validates them.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -lt 2 ]; then
    printf 'usage: parishctl apps install-file <jail> <file> [flags]\n' >&2
    exit 2
fi

jail="$1"
shift
# Remaining args: <file> [flags]. Pass through to parish-apps which
# validates the file path and flag syntax.

validate_jail_name_existing "$jail" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained)
        : # proceed
        ;;
    stopped)
        printf 'parishctl: compartment "%s" is not running.\n' "$jail" >&2
        printf 'Start it first:\n  pkexec parishctl-start %s\n' "$jail" >&2
        exit 1
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

exec /usr/local/bin/parish-apps install-file "$jail" "$@"
#!/bin/sh
# parishctl-create - Create a new container
set -eu

name=""
template=""
personality=""

while [ $# -gt 0 ]; do
    case "$1" in
        --template=*) template="${1#*=}" ;;
        --*) echo "parish: unknown flag $1" >&2; exit 2 ;;
        *)
            if [ -z "$name" ]; then name="$1"
            elif [ -z "$personality" ]; then personality="$1"
            else echo "parish: too many arguments" >&2; exit 2; fi
            ;;
    esac
    shift
done

if [ -z "$name" ]; then
    echo "parish: container name required" >&2
    exit 2
fi

case "$name" in
    ''|*[!a-z0-9-]*|-*|*-|*--*) echo "parish: invalid container name '$name'" >&2; exit 2 ;;
esac

if [ -n "$template" ]; then
    case "$template" in
        ''|*[!a-z0-9-]*|-*|*-|*--*) 
            echo "parish: invalid template name '$template'" >&2; 
            exit 2 ;;
    esac
    
    # T4b-B6: Refuse vault templates (D-vault scope)
    case "$template" in
        vault-*)
            echo "parish: vault creation is not supported through 'parishctl create --template=' yet." >&2
            echo "        Vault support is planned for the D-vault module." >&2
            echo "        No data was created." >&2
            exit 1
            ;;
    esac
    
    # T4b R1: Derive tier from template prefix
    case "$template" in
        vault-*) tier="vault" ;;
        *)       tier="app"   ;;
    esac
    
    LIBDIR=/usr/local/libexec/parishbsd/lib
    . "$LIBDIR/validate.sh"
    . "$LIBDIR/state.sh"
    . "$LIBDIR/service.sh"
    
    echo "Creating container '$name' from template '$template'..."
    
    cleanup_on_fail() {
        /usr/local/libexec/parishbsd/31-destroy-jail.sh "$name" 2>/dev/null || true
        rm -rf "/var/db/parishbsd/compartments/$name" 2>/dev/null || true
        rm -rf "/var/parishbsd/exchange/$name" 2>/dev/null || true
    }
    trap cleanup_on_fail EXIT INT TERM
    
    # Reference implementation (mode switch)
    /usr/local/libexec/parishbsd/30-create-jail.sh "$name" "--template=$template"
    
    meta_dir="/var/db/parishbsd/compartments/$name"
    mkdir -p "$meta_dir"
    _meta_tmp="${meta_dir}/metadata.conf.tmp.$$"
    cat > "$_meta_tmp" <<EOF
name=$name
source_template=$template
created=$(date -u +%Y%m%dT%H%M%SZ)
EOF
    chmod 0600 "$_meta_tmp"
    sync
    mv "$_meta_tmp" "${meta_dir}/metadata.conf"
    
    # Start the jail via the shared helper
    parish_service_start "$name" "/usr/local/jails/$tier/$name"
    
    trap - EXIT INT TERM
    echo "Container '$name' created from template '$template'"
else
    if [ -z "$personality" ]; then
        echo "parish: personality or --template is required" >&2
        exit 2
    fi
    /usr/local/libexec/parishbsd/30-create-jail.sh "$name" "$personality"
    echo "Container '$name' created from personality '$personality'"
fi
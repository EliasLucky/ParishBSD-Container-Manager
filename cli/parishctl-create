#!/bin/sh
# parishctl-create - Create a new container
set -eu

name=""
template=""
personality=""

while [ $# -gt 0 ]; do
    case "$1" in
        --template=*) template="${1#*=}" ;;
        --*) echo "parish: unknown flag $1" >&2; exit 2 ;;
        *)
            if [ -z "$name" ]; then name="$1"
            elif [ -z "$personality" ]; then personality="$1"
            else echo "parish: too many arguments" >&2; exit 2; fi
            ;;
    esac
    shift
done

if [ -z "$name" ]; then
    echo "parish: container name required" >&2
    exit 2
fi

case "$name" in
    ''|*[!a-z0-9-]*|-*|*-|*--*) echo "parish: invalid container name '$name'" >&2; exit 2 ;;
esac

if [ -n "$template" ]; then
    case "$template" in
        ''|*[!a-z0-9-]*|-*|*-|*--*) 
            echo "parish: invalid template name '$template'" >&2; 
            exit 2 ;;
    esac
    
    # T4b-B6 (Option A): Refuse vault templates
    case "$template" in
        vault-*)
            echo "parish: vault creation is not supported through 'parishctl create --template=' yet." >&2
            echo "        Vault support is planned." >&2
            echo "        No data was created." >&2
            exit 1
            ;;
    esac
    
    LIBDIR=/usr/local/libexec/parishbsd/lib
    . "$LIBDIR/validate.sh"
    . "$LIBDIR/state.sh"
    . "$LIBDIR/service.sh"
    
    state_conf="/var/db/parishbsd/templates/$template/template.conf"
    [ -f "$state_conf" ] || state_conf="/usr/local/share/parishbsd/templates/$template/template.conf"
    [ -f "$state_conf" ] || { echo "parish: template '$template' not found" >&2; exit 1; }
    
    current_base=$(grep '^current_base=' "$state_conf" | cut -d= -f2 | sed 's/^@//')
    [ -n "$current_base" ] || { echo "parish: template '$template' has no current_base (is it built?)" >&2; exit 1; }
    
    zfs list -H -t snapshot -o name "zroot/jails/templates/$template@$current_base" >/dev/null 2>&1 \
        || { echo "parish: template '$template' is missing its current_base snapshot '$current_base'" >&2
             echo "        Run: parishctl template update $template" >&2
             exit 1; }
             
    if zfs list -H -o name "zroot/jails/app/$name" >/dev/null 2>&1; then
        echo "parish: container '$name' already exists (dataset)" >&2
        echo "        To recreate: parishctl destroy $name" >&2
        exit 1
    fi
    if [ -d "/var/db/parishbsd/compartments/$name" ]; then
        echo "parish: container '$name' metadata already exists" >&2
        echo "        Check: parishctl show $name; remove manually if this is stale" >&2
        exit 1
    fi

    echo "Creating container '$name' from template '$template'..."
    
    cleanup_on_fail() {
        # T4b-S9: Stop jail first
        parish_service_stop "$name" "/usr/local/jails/app/$name" 2>/dev/null || true
        /usr/sbin/jail -r "$name" 2>/dev/null || true
        # T4b-S10: Unmount before destroy
        zfs unmount -f "zroot/jails/app/$name" 2>/dev/null || true
        # Then destroy dataset
        zfs destroy -r "zroot/jails/app/$name" 2>/dev/null || true
        rm -rf "/var/db/parishbsd/compartments/$name" 2>/dev/null || true
        rm -f "/etc/jail.conf.d/$name.conf" 2>/dev/null || true
    }
    
    # Ensure parent ZFS dataset exists (T4b-B8)
    zfs list -H -o name zroot/jails/app >/dev/null 2>&1 || zfs create -p zroot/jails/app
    
    zfs clone "zroot/jails/templates/$template@$current_base" "zroot/jails/app/$name"
    trap cleanup_on_fail EXIT INT TERM
    
    zfs set mountpoint="/usr/local/jails/app/$name" "zroot/jails/app/$name"
    zfs mount "zroot/jails/app/$name" 2>/dev/null || true  # T4b-S8
    
    mkdir -p "/var/db/parishbsd/compartments/$name"
    cat > "/var/db/parishbsd/compartments/$name/metadata.conf" <<EOF
name=$name
source_template=$template
created=$(date -u +%Y%m%dT%H%M%SZ)
EOF
    chmod 0600 "/var/db/parishbsd/compartments/$name/metadata.conf"
    
    mkdir -p /etc/jail.conf.d
    cat > "/etc/jail.conf.d/$name.conf" <<EOF
exec.clean = 1;
exec.start = "/bin/sh /etc/rc";
exec.stop = "/bin/sh /etc/rc.shutdown";
exec.consolelog = "/var/log/jail_${name}_console.log";
path = "/usr/local/jails/app/$name";
host.hostname = "${name}.parishbsd.local";
securelevel = 1;
allow.mlock;
mount.devfs;
devfs_ruleset = 4;
EOF

    parish_service_start "$name" "/usr/local/jails/app/$name"
    
    trap - EXIT INT TERM
    echo "Container '$name' created from template '$template'"
else
    if [ -z "$personality" ]; then
        echo "parish: personality or --template is required" >&2
        exit 2
    fi
    /usr/local/libexec/parishbsd/30-create-jail.sh "$name" "$personality"
    echo "Container '$name' created from personality '$personality'"
fi
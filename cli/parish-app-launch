#!/bin/sh
# parish-app-launch - launch an application inside a compartment.
#
# Called by .desktop shortcuts and by the Compartments Manager.
#
# TRUST MODEL
# -----------
# Launcher metadata is read ONLY from the host-side store at
# /var/db/parishbsd/launchers/<jail>/<slug>.conf. It is root-owned,
# 0644, and jail-invisible (the jail cannot see /var/db/parishbsd/).
# A jail that retargets the launcher command (e.g., "Firefox" ->
# "/usr/local/bin/lookalike") cannot do so: the metadata file is not
# on the jail's filesystem.
#
# The metadata file has a `jail=<name>` header. parish-app-launch
# verifies it matches the jail it was invoked for. A mismatch refuses
# with a message rather than executing the wrong commands.

set -eu
umask 077

readonly LIBDIR=/usr/local/libexec/parishbsd/lib
readonly DIALOG=/usr/local/libexec/parishbsd/parish-compartment-dialog
readonly PKEXEC=/usr/bin/pkexec
readonly PARISHCTL=/usr/local/sbin/parishctl
readonly PARISH_JAIL_RUN=/usr/local/sbin/parish-jail-run
readonly PARISH_XPRA=/usr/local/bin/parish-xpra
readonly LAUNCHER_STORE=/var/db/parishbsd/launchers

. "${LIBDIR}/validate.sh"
. "${LIBDIR}/state.sh"

# --- Argument validation ---

if [ "$#" -ne 2 ]; then
    printf 'parish-app-launch: usage: parish-app-launch <jail> <app>\n' >&2
    exit 4
fi

jail="$1"
app_name="$2"

validate_jail_name_existing "$jail" || exit 4
validate_app_name "$app_name" || exit 4

# --- Dialog helper ---
#
# The dialog prints a numeric ID on stdout, exits 0 on normal click,
# non-zero on window-manager close. A non-zero exit or empty output is
# treated as cancel (0). Trim whitespace without removing interior
# characters that could be digits.

_dialog_choice() {
    _out="$("$DIALOG" "$@" 2>/dev/null)" || _out=0
    _out="$(printf '%s' "$_out" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -n "$_out" ] || _out=0
    printf '%s' "$_out"
}

# --- Read launcher metadata (host-side only) ---

launcher_meta="${LAUNCHER_STORE}/${jail}/${app_name}.conf"

if [ ! -f "$launcher_meta" ] || [ -L "$launcher_meta" ]; then
    _choice="$(_dialog_choice --type=error --title="Application not found" \
        --text="The application \"${app_name}\" has no launcher metadata for compartment \"${jail}\".

This usually means the launcher was created by an older version of the Compartments Manager. Reinstall the application from the Compartments Manager to create the launcher." \
        --button="Close:0")"
    exit 5
fi

# Verify the jail= header matches. A path-mismatch read is refused
# rather than executed.
_meta_jail="$(awk -F= '/^jail=/{print substr($0, 6); exit}' "$launcher_meta")"
if [ "$_meta_jail" != "$jail" ]; then
    _choice="$(_dialog_choice --type=error --title="Launcher metadata mismatch" \
        --text="The launcher metadata for \"${app_name}\" belongs to a different compartment (found: \"${_meta_jail}\", expected: \"${jail}\").

This is a system error. Reinstall the application from the Compartments Manager, or contact support." \
        --button="Close:0")"
    exit 5
fi

# Parse ARGV[n]="..." lines. Fails closed on malformed / duplicate /
# gap. Comment lines (#) and header lines (jail=, slug=, written_at=) are ignored by the pattern.
_argv_string="$(awk '
    BEGIN { max = -1 }
    /^#/ { next }
    /^ARGV\[/ {
        if ($0 !~ /^ARGV\[[0-9]+\]=".*"$/) {
            print "MALFORMED: " $0 > "/dev/stderr"
            exit 2
        }
        n_str = substr($0, 6, index($0, "]") - 6)
        v_start = index($0, "\"") + 1
        v_end = length($0) - 1
        n = n_str + 0
        if (n in values) {
            print "DUPLICATE index " n > "/dev/stderr"
            exit 3
        }
        values[n] = substr($0, v_start, v_end - v_start + 1)
        if (n > max) max = n
    }
    END {
        for (i = 0; i <= max; i++) {
            if (!(i in values)) {
                print "GAP at index " i > "/dev/stderr"
                exit 4
            }
            print values[i]
        }
    }
' "$launcher_meta")" || {
    _choice="$(_dialog_choice --type=error --title="Launcher metadata is malformed" \
        --text="The launch information for \"${app_name}\" in compartment \"${jail}\" is malformed and cannot be used.

Reinstall the application from the Compartments Manager." \
        --button="Close:0")"
    exit 5
}

if [ -z "$_argv_string" ]; then
    _choice="$(_dialog_choice --type=error --title="Application has no launch command" \
        --text="The application \"${app_name}\" in compartment \"${jail}\" has no launch command.

Reinstall the application from the Compartments Manager." \
        --button="Close:0")"
    exit 5
fi

# Convert newline-separated values into positional parameters.
set --
while IFS= read -r _arg; do
    set -- "$@" "$_arg"
done <<LAUNCH_ARGV_END
$_argv_string
LAUNCH_ARGV_END

# --- Compartment state check ---

state="$(parish_jail_state "$jail")"

case "$state" in
    containing|contained|containment-failed|contained-but-running|stopped-maybe-contained|unknown)
        _sentence="$(parish_jail_state_message "$jail" "$state")"
        _choice="$(_dialog_choice --type=error \
            --title="Compartment not safe to launch" \
            --text="$_sentence" \
            --button="Close:0")"
        exit 2
        ;;
    running|running-other-contained)
        : # proceed (C1: silent allow for a running compartment)
        ;;
    stopped)
        _choice="$(_dialog_choice --type=question \
            --title="Start compartment?" \
            --text="The compartment \"${jail}\" is not running.

To launch \"${app_name}\", the compartment must be started first. Starting a compartment runs a small isolated FreeBSD environment.

Start the compartment and launch \"${app_name}\"?" \
            --button="Start and launch:10" \
            --button="Cancel:0")"
        [ "$_choice" = "10" ] || exit 1

        _rc=0
        "$PKEXEC" "$PARISHCTL" start "$jail" || _rc=$?
        if [ "$_rc" -ne 0 ]; then
            case "$_rc" in
                126) _sentence="Authentication was cancelled. The compartment was not started. Launch the application again if this was accidental." ;;
                127) _sentence="The parishctl command could not be run. Check that parishbsd-compartments is installed correctly." ;;
                *)   _sentence="The compartment \"${jail}\" could not be started.

Run for details:
  pkexec parishctl show ${jail}" ;;
            esac
            _choice="$(_dialog_choice --type=error --title="Could not start compartment" \
                --text="$_sentence" --button="Close:0")"
            exit 5
        fi

        # Re-check state after start (a containment may have fired).
        state="$(parish_jail_state "$jail")"
        case "$state" in
            running|running-other-contained) : ;;
            *)
                _sentence="$(parish_jail_state_message "$jail" "$state")"
                _choice="$(_dialog_choice --type=error \
                    --title="Compartment not safe to launch" \
                    --text="$_sentence" \
                    --button="Close:0")"
                exit 2
                ;;
        esac
        ;;
    *)
        printf 'parish-app-launch: internal error: unknown state "%s"\n' "$state" >&2
        exit 6
        ;;
esac

# --- Vault-locked pre-check (defense in depth; parishctl start has the
#     second layer) ---

if [ -d "/usr/local/jails/vault/${jail}" ]; then
    _keystatus="$(zfs get -H -o value keystatus "zroot/vault-data/$jail" 2>/dev/null || true)"
    case "$_keystatus" in
        available) : ;;
        unavailable)
            _sentence="The vault \"${jail}\" is locked.

A vault needs a passphrase to unlock. Launching it from the desktop does not give you a place to type the passphrase.

To unlock it:
  1. Open a terminal (in the applications menu, under System or Utilities).
  2. Run: pkexec parishctl unlock ${jail}
  3. Type the passphrase when prompted.
  4. Launch this application again."
            _choice="$(_dialog_choice --type=error --title="Vault is locked" \
                --text="$_sentence" --button="Close:0")"
            exit 5
            ;;
        *)
            _sentence="Cannot determine the state of vault \"${jail}\".

Check with:
  zfs get keystatus zroot/vault-data/${jail}
  zpool status"
            _choice="$(_dialog_choice --type=error --title="Cannot check vault" \
                --text="$_sentence" --button="Close:0")"
            exit 5
            ;;
    esac
fi

# --- Start display server ---

_rc=0
"$PKEXEC" "$PARISHCTL" xpra start "$jail" || _rc=$?
if [ "$_rc" -ne 0 ]; then
    case "$_rc" in
        126) _sentence="Authentication was cancelled, so the display session was not started.

The compartment is still running. Launch the application again if this was accidental." ;;
        127) _sentence="The parishctl command could not be run. Check that parishbsd-compartments is installed correctly." ;;
        *)   _sentence="The compartment \"${jail}\" is running, but its display session could not be started.

The application needs a display session to be visible.

The compartment is still running. Do not restart it until this is resolved.

To check manually:
  pkexec parishctl xpra start ${jail}" ;;
    esac
    _choice="$(_dialog_choice --type=error --title="Display session failed" \
        --text="$_sentence" --button="Close:0")"
    # Do NOT auto-stop the compartment. P3 (no surprise side effects);
    # P5 (name the partial state honestly).
    exit 5
fi

# --- Attach display client (background, best-effort) ---
#
# 0.3 s heuristic: if the process is still alive after 0.3 s, assume
# it connected. A better check would look for the Xpra socket path
# The user can attach manually with `parish-xpra attach <jail>` if the heuristic fails.

"$PARISH_XPRA" attach "$jail" >/dev/null 2>&1 &
_attach_pid=$!
sleep 0.3
if ! kill -0 "$_attach_pid" 2>/dev/null; then
    _sentence="The display client could not be started for \"${jail}\".

The application will start, but you will not see it until you run:
  parish-xpra attach ${jail}

The compartment is still running."
    _choice="$(_dialog_choice --type=warning --title="Display client failed" \
        --text="$_sentence" --button="Continue:0")"
    # Proceed — the app starts; user can attach later.
fi

# --- Launch the application ---

_rc=0
"$PKEXEC" "$PARISH_JAIL_RUN" "$jail" "$@" || _rc=$?
if [ "$_rc" -ne 0 ]; then
    case "$_rc" in
        126) _sentence="Authentication was cancelled, so the application was not started.

The compartment and its display session are still running." ;;
        127) _sentence="The parish-jail-run command could not be run. Check that parishbsd-compartments is installed correctly." ;;
        *)   _sentence="The application \"${app_name}\" could not be started in the compartment \"${jail}\".

The compartment is running and its display session is open. You may:
  - Try launching again.
  - Open a terminal and run: pkexec parishctl console ${jail}
    to investigate." ;;
    esac
    _choice="$(_dialog_choice --type=error --title="Could not launch application" \
        --text="$_sentence" --button="Close:0")"
    exit 5
fi

exit 0
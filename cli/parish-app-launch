#!/bin/sh
# parish-app-launch  launch an application inside a compartment.
#
# Called by .desktop shortcuts and by the Compartments Manager.
#
# This tool orchestrates the launch. It does not jail anything itself;
# parish-jail-run does that (as root, via pkexec). Its job is:
#
#   1. Check compartment state. Refuse if contained, in-flight, or unclear.
#   2. Refuse if it is a vault and the vault is locked (no TTY for prompt).
#   3. Prompt the user to start the compartment if it is stopped.
#   4. Start the compartment (pkexec parishctl start).
#   5. Ensure the display server is running (pkexec parishctl xpra start).
#   6. Attach a display client (parish-xpra attach, background).
#   7. Launch the application (pkexec parish-jail-run).
#
# Failure paths are honest. If step 4 succeeds and step 5 fails, the
# compartment stays running. We do not auto-stop a successfully-started
# compartment.

set -eu
umask 077

readonly LIBDIR=/usr/local/libexec/parishbsd/lib
readonly DIALOG=/usr/local/libexec/parishbsd/parish-compartment-dialog
readonly PKEXEC=/usr/bin/pkexec
readonly PARISHCTL=/usr/local/sbin/parishctl
readonly PARISH_JAIL_RUN=/usr/local/sbin/parish-jail-run
readonly PARISH_XPRA=/usr/local/bin/parish-xpra
readonly DISPLAY_NUM=":100"

. "${LIBDIR}/validate.sh"
. "${LIBDIR}/state.sh"

# --- Argument validation ---

if [ "$#" -ne 2 ]; then
    printf 'parish-app-launch: usage: parish-app-launch <jail> <app>\n' >&2
    exit 4
fi

jail="$1"
app_name="$2"

validate_jail_name_existing "$jail" || exit 4

case "$app_name" in
    ''|*/*|*..*|*[!A-Za-z0-9._+-]*)
        printf 'parish-app-launch: invalid application name: %s\n' "$app_name" >&2
        exit 4
        ;;
esac

# --- Dialog helper wrapper: consistent exit-code handling ---
#
# The dialog prints a numeric ID on stdout and exits 0 on normal click,
# non-zero on window-manager close. A non-zero exit or empty output is
# treated as cancel (0).
_dialog_choice() {
    _out="$("$DIALOG" "$@" 2>/dev/null)" || _out=0
    _out="$(printf '%s' "$_out" | tr -d '[:space:]')"
    [ -n "$_out" ] || _out=0
    printf '%s' "$_out"
}

# --- Locate the metadata file (parsed, never sourced) ---

meta_dir="/usr/local/jails/app/${jail}/usr/local/etc/parishbsd/custom-apps"
meta_file=""

if [ -d "$meta_dir" ]; then
    for f in "$meta_dir"/*.conf; do
        [ -f "$f" ] || continue
        [ ! -L "$f" ] || continue
        _n="$(awk -F'"' '/^NAME=/{print $2; exit}' "$f")"
        if [ "$_n" = "$app_name" ]; then
            meta_file="$f"
            break
        fi
    done
fi

if [ -z "$meta_file" ]; then
    _choice="$(_dialog_choice --type=error --title="Application not found" \
        --text="The application \"${app_name}\" is not installed in the compartment \"${jail}\"." \
        --button="Close:0")"
    exit 5
fi

# --- Read the launch command as argv (B8=a) ---
#
# Metadata format: one ARGV[n]="..." per line, in order. No single
# LAUNCHER_COMMAND string. No shell splitting. No glob expansion.
#
# The awk below:
#   - matches only lines of the exact form ARGV[n]="value"
#   - orders by n regardless of file order
#   - rejects malformed lines (no end quote) silently — they produce
#     no output, which means the argv list is incomplete, and the
#     launch refuses with "no launch command"
#   - no eval, no source

_argv_string="$(awk '
    {
        if ($0 ~ /^ARGV\[[0-9]+\]=".*"$/) {
            n_str = substr($0, 6, index($0, "]") - 6)
            v_start = index($0, "\"") + 1
            v_end = length($0) - 1
            n = n_str + 0
            v = substr($0, v_start, v_end - v_start + 1)
            values[n] = v
            if (n > max) max = n
        }
    }
    END {
        for (i = 0; i <= max; i++) {
            if (i in values) print values[i]
        }
    }
' "$meta_file")"

if [ -z "$_argv_string" ]; then
    _choice="$(_dialog_choice --type=error --title="Application is not launchable" \
        --text="The application \"${app_name}\" in \"${jail}\" has no launch command. Reinstall it from the Compartments Manager." \
        --button="Close:0")"
    exit 5
fi

# Convert newline-separated values into positional parameters. Each line
# is one argv element. Values containing embedded newlines are rejected
# by the awk pattern above (they cannot match a line ending in ").
set --
while IFS= read -r _arg; do
    set -- "$@" "$_arg"
done <<LAUNCH_ARGV_END
$_argv_string
LAUNCH_ARGV_END

# --- Compartment state check ---

state="$(parish_jail_state "$jail")"

case "$state" in
    containing|contained|containment-failed|contained-but-running|stopped-maybe-contained|unknown)
        _sentence="$(parish_jail_state_message "$jail" "$state")"
        _choice="$(_dialog_choice --type=error \
            --title="Compartment not safe to launch" \
            --text="$_sentence" \
            --button="Close:0")"
        exit 2
        ;;
    running|running-other-contained)
        : # proceed (C1: silent allow; running compartment is already a
          # safety decision the user made; adding a process does not
          # change the attack surface)
        ;;
    stopped)
        _choice="$(_dialog_choice --type=question \
            --title="Start compartment?" \
            --text="The compartment \"${jail}\" is not running.

To launch \"${app_name}\", the compartment must be started first. Starting a compartment runs a small isolated FreeBSD environment.

Start the compartment and launch \"${app_name}\"?" \
            --button="Start and launch:10" \
            --button="Cancel:0")"
        if [ "$_choice" != "10" ]; then
            exit 1
        fi

        if ! "$PKEXEC" "$PARISHCTL" start "$jail"; then
            _rc=$?
            case "$_rc" in
                126) _sentence="Authentication was cancelled. The compartment was not started. Launch the application again if this was accidental." ;;
                127) _sentence="The parishctl command could not be run. Check that parishbsd-compartments is installed correctly." ;;
                *)   _sentence="The compartment \"${jail}\" could not be started.

Run: pkexec parishctl show ${jail}
for details." ;;
            esac
            _choice="$(_dialog_choice --type=error --title="Could not start compartment" \
                --text="$_sentence" --button="Close:0")"
            exit 5
        fi

        # Re-check state after start. parishctl start performs its own
        # post-condition check (item 6); we re-check here so a containment
        # that fired during startup is caught before we proceed to launch.
        state="$(parish_jail_state "$jail")"
        case "$state" in
            running|running-other-contained) : ;;
            *)
                _sentence="$(parish_jail_state_message "$jail" "$state")"
                _choice="$(_dialog_choice --type=error \
                    --title="Compartment not safe to launch" \
                    --text="$_sentence" \
                    --button="Close:0")"
                exit 2
                ;;
        esac
        ;;
    *)
        printf 'parish-app-launch: internal error: unknown state "%s"\n' "$state" >&2
        exit 6
        ;;
esac

# --- Vault-locked pre-check (defense in depth; parishctl start has the
#     second layer per item 6) ---

if [ -d "/usr/local/jails/vault/${jail}" ]; then
    _keystatus="$(zfs get -H -o value keystatus "zroot/vault-data/$jail" 2>/dev/null || true)"
    case "$_keystatus" in
        available) : ;;
        unavailable)
            _sentence="The vault \"${jail}\" is locked.

A vault needs a passphrase to unlock. Launching it from the desktop does not give you a place to type the passphrase.

To unlock it:
  1. Open a terminal (in the applications menu, under System or Utilities).
  2. Run: pkexec parishctl unlock ${jail}
  3. Type the passphrase when prompted.
  4. Launch this application again."
            _choice="$(_dialog_choice --type=error --title="Vault is locked" \
                --text="$_sentence" --button="Close:0")"
            exit 5
            ;;
        *)
            _sentence="Cannot determine the state of vault \"${jail}\".

Check with:
  zfs get keystatus zroot/vault-data/${jail}
  zpool status"
            _choice="$(_dialog_choice --type=error --title="Cannot check vault" \
                --text="$_sentence" --button="Close:0")"
            exit 5
            ;;
    esac
fi

# --- Start the display server (idempotent; no-op if already running) ---

if ! "$PKEXEC" "$PARISHCTL" xpra start "$jail"; then
    _rc=$?
    case "$_rc" in
        126) _sentence="Authentication was cancelled, so the display session was not started. The compartment is still running. Launch the application again if this was accidental." ;;
        127) _sentence="The parishctl command could not be run. Check that parishbsd-compartments is installed correctly." ;;
        *)   _sentence="The compartment \"${jail}\" is running, but its display session could not be started.

The application needs a display session to be visible.

The compartment is still running. Do not restart it until this is resolved.

To check manually:
  pkexec parishctl xpra start ${jail}" ;;
    esac
    _choice="$(_dialog_choice --type=error --title="Display session failed" \
        --text="$_sentence" --button="Close:0")"
    # Do NOT auto-stop the compartment. It started successfully; the
    # display session failed. Per P3, side effects surprise the user.
    # Per P5, name the partial state honestly.
    exit 5
fi

# --- Attach display client (background, best-effort) ---
#
# parish-xpra attach runs as the user (no pkexec) and opens a display
# window on the user's desktop. It stays connected to the compartment's
# Xpra session until the session ends or the user closes the window.
#
# Best-effort: if it fails immediately, the app still launches and the
# user can attach manually with `parish-xpra attach <jail>`. The 0.3 s
# delay gives the attach a chance to fail before we proceed; if it is
# still running after 0.3 s, we assume success.

"$PARISH_XPRA" attach "$jail" >/dev/null 2>&1 &
_attach_pid=$!
sleep 0.3
if ! kill -0 "$_attach_pid" 2>/dev/null; then
    _sentence="The display client could not be started for \"${jail}\".

The application will start, but you will not see it until you run:
  parish-xpra attach ${jail}

The compartment is still running."
    _choice="$(_dialog_choice --type=warning --title="Display client failed" \
        --text="$_sentence" --button="Continue:0")"
    # Proceed — the app starts; user can attach later.
fi

# --- Launch the application ---

if ! "$PKEXEC" "$PARISH_JAIL_RUN" "$jail" "$@"; then
    _rc=$?
    case "$_rc" in
        126) _sentence="Authentication was cancelled, so the application was not started. The compartment and its display session are still running." ;;
        127) _sentence="The parish-jail-run command could not be run. Check that parishbsd-compartments is installed correctly." ;;
        *)   _sentence="The application \"${app_name}\" could not be started in the compartment \"${jail}\".

The compartment is running and its display session is open. You may:
  - Try launching again.
  - Open a terminal and run: pkexec parishctl console ${jail}
    to investigate." ;;
    esac
    _choice="$(_dialog_choice --type=error --title="Could not launch application" \
        --text="$_sentence" --button="Close:0")"
    exit 5
fi

exit 0
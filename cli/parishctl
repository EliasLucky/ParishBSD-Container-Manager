#!/bin/sh
# parishctl  ParishBSD Compartments dispatcher.
#
# Runs UNPRIVILEGED. Parses the verb and dispatches to one of:
#   - a per-verb binary via pkexec (privileged verbs)
#   - an unprivileged binary directly (help, version, detect, usb-list,
#     xpra-attach, apps-launch, apps-create-launcher, apps-pkg-launcher)
#
# Design rationale: polkit actions are keyed on the
# exec.path of the binary pkexec runs. A single "parishctl" binary
# with per-verb messages is not achievable through pkexec
# Splitting into per-verb binaries makes each
# action's prompt name the operation the user is about to perform.
#
# Unprivileged dispatcher (this file) > pkexec parishctl-<verb> >
# polkit action .<verb> > the verb runs as root > does the work.

set -eu
umask 022

readonly BINDIR_SBIN=/usr/local/sbin
readonly BINDIR_BIN=/usr/local/bin

usage() {
    cat <<'EOF'
parishctl - manage ParishBSD compartments

  Containers are isolated environments for running software.
  Applications are general-purpose; Vaults are encrypted storage
  for sensitive data.

VIEWING
  parishctl list                    List all compartments and state
  parishctl show <name>             Details for one compartment
  parishctl schedules               Show scheduled vault locks

CREATING
  parishctl create <name> [kind]    Create a compartment
                                    kind: app, vault-files, vault-postgres

RUNNING
  parishctl start <name>            Start a compartment
  parishctl stop <name>             Stop a compartment
  parishctl restart <name>          Restart a compartment
  parishctl console <name>          Open a shell inside

VAULTS
  parishctl unlock <name>           Unlock a vault (prompts for passphrase)
  parishctl lock <name>             Lock a vault (stops it too)

DESTROYING
  parishctl destroy <name>          Destroy a compartment. For vaults,
                                    the encrypted data is also destroyed.
                                    Cannot be undone.

SCHEDULES
  parishctl schedule-lock <v> HH:MM Lock a vault daily at HH:MM
  parishctl unschedule-lock <v>     Remove a schedule

APPLICATIONS
  parishctl apps install <jail> <pkg>     Install a FreeBSD package
  parishctl apps install-file <jail> <file>
                                          Install from a local file
  parishctl apps remove <jail> <pkg>      Remove a package
  parishctl apps remove-custom <jail> <app>
                                          Remove a custom app
  parishctl apps upgrade <jail> [pkg]     Upgrade packages
  parishctl apps launch <jail> <app>      Launch an app
  parishctl apps create-launcher <jail> <name> [where]
                                          Create a launcher
  parishctl apps pkg-launcher <jail> <pkg> [where]
                                          Create a launcher (alias)
  parishctl detect <file>                 Identify a file's type

USB
  parishctl usb list                List attached devices
  parishctl usb attach <jail> <dev> Attach a device (read-only)
  parishctl usb detach <jail> <dev> Detach a device

DISPLAY
  parishctl xpra start <jail>       Start Xpra for a compartment
  parishctl xpra attach <jail>      Attach a display client

REMOVED IN THIS VERSION

  apps set-launcher    Removed. To change what an application runs,
                       reinstall it with the corrected launcher file:
                         parishctl apps install-file <jail> <file>

TEXT CONSOLE (no graphical session)

  On a text console, pkexec may not have a working authentication
  agent. If authentication fails with "Bus error" or "AUTHENTICATING
  FAILED", run the per-verb command directly as root:

    su -
    /usr/local/sbin/parishctl-<verb> <args>

OTHER
  parishctl help                    This message
  parishctl version                 Show version

Aliases: ls=list, info=show, shell=console, rm=destroy, delete=destroy
EOF
}

version() {
    _v="$(cat /usr/local/share/parishbsd/VERSION 2>/dev/null || echo unknown)"
    printf 'parishctl (ParishBSD) %s\n' "$_v"
}

err() { printf 'parishctl: %s\n' "$*" >&2; exit 2; }

# --------------------------------------------------------------------
# Pre-flight checks (called by every pkexec-chaining path)
# --------------------------------------------------------------------

_require_unprivileged() {
    if [ "$(id -u)" -eq 0 ]; then
        err "must be run as an unprivileged user; the per-verb commands are invoked via pkexec by the dispatcher."
    fi
}

_require_executable() {
    if [ ! -x "$1" ]; then
        err "unknown command: $2 (try 'parishctl help'; if valid, the binary '$1' may be missing)"
    fi
}

# --------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------

verb="${1:-help}"
[ "$#" -gt 0 ] && shift

# Compound verbs: apps <sub>, usb <sub>, xpra <sub>.
case "$verb" in
    apps|usb|xpra)
        [ "$#" -gt 0 ] || err "usage: parishctl $verb <subcommand> [args]"
        sub="$1"; shift
        verb="$verb-$sub"
        ;;
esac

# Special-case: launcher creation routes to a single privileged binary
# (no per-app wrapper; .create-launcher is the polkit action for both
# create-launcher and pkg-launcher).
case "$verb" in
    apps-create-launcher|apps-pkg-launcher)
        _create_launcher_bin=/usr/local/sbin/parish-app-create-launcher
        _require_unprivileged
        _require_executable "$_create_launcher_bin" "$verb"
        _rc=0
        pkexec "$_create_launcher_bin" "$@" || _rc=$?
        case "$_rc" in
            126|135)
                printf '\n' >&2
                printf 'parishctl: authentication failed (exit %d).\n' "$_rc" >&2
                printf 'On a text console, polkit may not have an auth agent.\n' >&2
                printf 'Try running directly as root:\n' >&2
                printf '  su -\n' >&2
                printf '  %s %s\n' "$_create_launcher_bin" "$*" >&2
                ;;
        esac
        exit "$_rc"
        ;;
esac

# Normalise aliases.
case "$verb" in
    ls)                    verb=list ;;
    info)                  verb=show ;;
    shell|sh|exec)         verb=console ;;
    rm|delete|remove)      verb=destroy ;;
    up)                    verb=start ;;
    down)                  verb=stop ;;
    new)                   verb=create ;;
esac

# Unprivileged direct-exec verbs.
case "$verb" in
    help|-h|--help) usage; exit 0 ;;
    version|-v)     version; exit 0 ;;
    detect)
        exec "$BINDIR_BIN/parish-detect-installer" "$@"
        ;;
    usb-list)
        exec "$BINDIR_BIN/parish-usb" list "$@"
        ;;
    xpra-attach)
        # Xpra attach is a display client on the user's desktop;
        # runs unprivileged.
        exec "$BINDIR_BIN/parish-xpra" attach "$@"
        ;;
    apps-launch)
        # launch is unprivileged. parish-app-launch internally
        # calls pkexec for the privileged steps (start, xpra-start,
        # jail-run).
        _require_unprivileged
        exec "$BINDIR_BIN/parish-app-launch" "$@"
        ;;
esac

# Privileged verbs (per-verb lookup + pkexec + failure-site handling).
#
# pkexec without `--` (pkexec's GLib parser treats
# `--` as the program name; absolute-path argv[0] always identifies as
# PROGRAM and stops option parsing there).
#
# Failure-site handling: pkexec failures on text
# consoles have a specific recovery (auth agent unavailable) that the
# user must know about at the moment of failure. Exit codes:
#   126  pkexec auth cancelled/failed
#   135  128 + SIGBUS (7); the polkit auth helper crashes on some
#         FreeBSD consoles instead of cleanly exiting 126 (observed:
#         "Bus error" after "AUTHENTICATING FAILED")
_bin="$BINDIR_SBIN/parishctl-$verb"
_require_executable "$_bin" "$verb"
_require_unprivileged

_rc=0
pkexec "$_bin" "$@" || _rc=$?
case "$_rc" in
    126|135)
        printf '\n' >&2
        printf 'parishctl: authentication failed (exit %d).\n' "$_rc" >&2
        printf 'On a text console (no graphical session), polkit may not\n' >&2
        printf 'have an authentication agent available.\n' >&2
        printf '\n' >&2
        printf 'Try running the command directly as root:\n' >&2
        printf '  su -\n' >&2
        printf '  %s %s\n' "$_bin" "$*" >&2
        printf '\n' >&2
        printf 'On a graphical desktop, run from a terminal window (not\n' >&2
        printf 'a text console) so the polkit agent can prompt.\n' >&2
        ;;
esac
exit "$_rc"
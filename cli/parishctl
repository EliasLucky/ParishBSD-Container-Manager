#!/bin/sh
# parishctl  ParishBSD Compartments dispatcher.
#
# Runs UNPRIVILEGED. Parses the verb and dispatches to one of:
#   - a local helper for help/version (no privileged work)
#   - pkexec parishctl-<verb> for privileged verbs (pkexec prompts if
#     needed; polkit's allow_active=yes skips the prompt for read-only
#     verbs on the console)
#   - a direct exec for unprivileged verbs (detect, usb list)

set -eu
umask 022

readonly BINDIR_SBIN=/usr/local/sbin
readonly BINDIR_BIN=/usr/local/bin

usage() {
    cat <<'EOF'
parishctl - manage ParishBSD compartments

  Containers are isolated environments for running software.
  Applications are general-purpose; Vaults are encrypted storage
  for sensitive data.

VIEWING
  parishctl list                    List all compartments and state
  parishctl show <name>             Details for one compartment
  parishctl schedules               Show scheduled vault locks

CREATING
  parishctl create <name> [kind]    Create a compartment
                                    kind: app, vault-files, vault-postgres

RUNNING
  parishctl start <name>            Start a compartment
  parishctl stop <name>             Stop a compartment
  parishctl restart <name>          Restart a compartment
  parishctl console <name>          Open a shell inside

VAULTS
  parishctl unlock <name>           Unlock a vault (prompts for passphrase)
  parishctl lock <name>             Lock a vault (stops it too)

DESTROYING
  parishctl destroy <name>          Destroy a compartment. For vaults,
                                    the encrypted data is also destroyed.
                                    Cannot be undone.

SCHEDULES
  parishctl schedule-lock <v> HH:MM Lock a vault daily at HH:MM
  parishctl unschedule-lock <v>     Remove a schedule

APPLICATIONS
  parishctl apps list <jail>        List installed apps
  parishctl apps install <jail> <pkg>
  parishctl apps install-file <jail> <file>
  parishctl apps remove <jail> <pkg>
  parishctl apps upgrade <jail>
  parishctl detect <file>           Identify a file's type

USB
  parishctl usb list                List attached devices
  parishctl usb attach <jail> <dev> Attach a device (read-only)
  parishctl usb detach <jail> <dev> Detach a device

DISPLAY
  parishctl xpra start <jail>       Start Xpra for a compartment
  parishctl xpra attach <jail>      Attach a display client
  parishctl vault-files <name>      Open a vault's file manager

OTHER
  parishctl help                    This message
  parishctl version                 Show version

Aliases: ls=list, info=show, shell=console, rm=destroy, delete=destroy
EOF
}

version() {
    _v="$(cat /usr/local/share/parishbsd/VERSION 2>/dev/null || echo unknown)"
    printf 'parishctl (ParishBSD) %s\n' "$_v"
}

err() { printf 'parishctl: %s\n' "$*" >&2; exit 2; }

# --- Dispatch ---

verb="${1:-help}"
[ "$#" -gt 0 ] && shift

# Compound verbs: apps <sub>, usb <sub>.
case "$verb" in
    apps|usb)
        [ "$#" -gt 0 ] || err "usage: parishctl $verb <subcommand> [args]"
        sub="$1"; shift
        verb="$verb-$sub"
        ;;
esac

# Normalise aliases.
case "$verb" in
    ls)                    verb=list ;;
    info)                  verb=show ;;
    shell|sh|exec)         verb=console ;;
    rm|delete|remove)      verb=destroy ;;
    up)                    verb=start ;;
    down)                  verb=stop ;;
    new)                   verb=create ;;
esac

# Unprivileged direct-exec verbs.
case "$verb" in
    help|-h|--help) usage; exit 0 ;;
    version|-v)     version; exit 0 ;;
    detect)
        exec "$BINDIR_BIN/parish-detect-installer" "$@"
        ;;
    usb-list)
        exec "$BINDIR_BIN/parish-usb" list "$@"
        ;;
esac

# Privileged verbs. Locate the per-verb binary, refuse if missing (before pkexec).
bin="$BINDIR_SBIN/parishctl-$verb"
if [ ! -x "$bin" ]; then
    err "unknown command: $verb (try 'parishctl help')"
fi

# $bin is a readonly absolute path starting with /, so pkexec always identifies
# it as PROGRAM and stops parsing there.
exec pkexec "$bin" "$@"
#!/bin/sh
# parish-app-create-launcher  create .desktop launchers for an application.
#
# Usage: parish-app-create-launcher <jail> <name> [menu|desktop|both]
#
# Runs as root via pkexec (invoked from parishctl apps create-launcher,
# or directly by the GUI as /usr/local/sbin/parish-app-create-launcher).
#
# TWO INPUT PATHS:
#
#   1. Host-side metadata exists (installs, written by
#      parish-apps install-file or parish-apps install). Read name,
#      icon from /var/db/parishbsd/launchers/<jail>/<slug>.conf.
#      Write .desktop from that. No jail reads. Preferred path.
#
#   2. Host-side metadata absent. This is the manual pkg install
#      path: user ran `pkg install` directly inside the jail, bypassing
#      parish-apps. Extract Exec=/Icon= from the in-jail .desktop, write
#      host-side metadata, then write .desktop from that.
#      JAIL-INFLUENCED: the extraction reads a jail-writable file. Any
#      modification since install is captured. Users who require
#      stronger guarantees should install via parish-apps (small window
#      at install time) rather than manual pkg install + create-launcher
#      (large window).
#
# Repo path: cli/parish-app-create-launcher
# Install path: /usr/local/sbin/parish-app-create-launcher

set -eu
umask 022

JAILS_DIR="/usr/local/jails"
LAUNCHER_STORE="/var/db/parishbsd/launchers"
LIBDIR=/usr/local/libexec/parishbsd/lib

. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"
. "$LIBDIR/desktop.sh"
. "$LIBDIR/launcher.sh"

log() { printf ' %s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

jail="${1:?usage: parish-app-create-launcher <jail> <name> [where]}"
name="${2:?usage: parish-app-create-launcher <jail> <name> [where]}"
where="${3:-menu}"

validate_jail_name_existing "$jail" || exit 2
validate_app_name "$name" || exit 2

parish_require_not_contained "$jail" || exit 1
case "$where" in
    menu|desktop|both) : ;;
    *) err "invalid --where value: $where" ;;
esac

# --- Refuse if legacy in-jail metadata exists (F2(B)) ---
for _tier in app vault containers; do
    _legacy="$JAILS_DIR/$_tier/$jail/usr/local/etc/parishbsd/custom-apps/$name.conf"
    if [ -f "$_legacy" ] && [ ! -L "$_legacy" ]; then
        cat >&2 <<EOF
The application "$name" in compartment "$jail" was installed by an
older version of the Compartments Manager. Its launcher metadata is in
a format that cannot be safely used.

Reinstall the application from the Compartments Manager to create a
working launcher. The old "set-launcher" command has been removed; to
change what the application runs, reinstall it with the corrected file.
EOF
        exit 1
    fi
done

# --- Resolve target user's home (B7=c) ---
if [ -n "${PKEXEC_UID:-}" ]; then
    target_uid="$PKEXEC_UID"
elif [ -n "${SUDO_UID:-}" ]; then
    target_uid="$SUDO_UID"
else
    target_uid="$(id -u)"
fi

target_home="$(pw usershow -u "$target_uid" -7 2>/dev/null | cut -d: -f9)"
if [ -z "$target_home" ] || [ ! -d "$target_home" ]; then
    err "cannot determine home directory for uid $target_uid"
fi

# --- Ensure host-side metadata exists ---
_meta="$LAUNCHER_STORE/$jail/$name.conf"

if [ ! -f "$_meta" ] || [ -L "$_meta" ]; then
    _desktop="$(_find_pkg_desktop "$jail" "$name")"

    if [ -z "$_desktop" ]; then
        err "no launcher source found for \"$name\" in \"$jail\"
The application may not be installed. Install it first:
  parishctl apps install $jail <package>"
    fi

    _display="$(jexec "$jail" sh -c 'grep "^Name=" "$1" | head -1 | cut -d= -f2-' _ "$_desktop")"
    _icon="$(jexec "$jail" sh -c 'grep "^Icon=" "$1" | head -1 | cut -d= -f2-' _ "$_desktop")"
    _exec="$(jexec "$jail" sh -c 'grep "^Exec=" "$1" | head -1 | cut -d= -f2-' _ "$_desktop")"
    _version="$(jexec "$jail" pkg query %v "$name" 2>/dev/null || echo 1.0)"

    if [ -z "$_exec" ]; then
        err "the .desktop for \"$name\" has no Exec= line"
    fi

    # Validate icon name; warn and use generic if invalid.
    case "$_icon" in
        '') : ;;
        */*|*..*)
            log "WARN: icon for $name is a path, using generic"
            _icon=""
            ;;
        *[!A-Za-z0-9._+-]*)
            log "WARN: icon for $name has invalid characters, using generic"
            _icon=""
            ;;
    esac

    case "$_exec" in
        *[\"\']*|*\\*)
            err "cannot parse $name.desktop Exec= line (quotes or backslashes)"
            ;;
    esac
    _cleaned="$(printf '%s' "$_exec" | sed 's/%[fFuUdDnNickvm]//g; s/%%/%/g')"
    set -f
    set -- $_cleaned
    set +f
    if [ "$#" -lt 1 ]; then
        err "no usable argv in $name.desktop Exec= line"
    fi

    write_host_launcher_metadata "$jail" "$name" "${_display:-$name}" "$_version" \
        "freebsd-pkg" "/usr/local" "$_icon" "$@"
fi

# --- Read metadata and write .desktop ---
_meta="$LAUNCHER_STORE/$jail/$name.conf"
[ -f "$_meta" ] || err "metadata missing for \"$name\""
[ ! -L "$_meta" ] || err "metadata is a symlink: $_meta"

_display="$(awk -F= '/^name=/{print substr($0, 6); exit}' "$_meta")"
_icon="$(awk -F= '/^icon=/{print substr($0, 6); exit}' "$_meta")"

[ -n "$_display" ] || _display="$name"
[ -n "$_icon" ]    || _icon="parish-container-app"

# --- Write .desktop file(s) ---
apps_dir="$target_home/.local/share/applications"
desk_dir="$target_home/Desktop"

mkdir -p "$apps_dir" 2>/dev/null || true
if [ -d "$apps_dir" ] && [ "$(stat -f %u "$apps_dir" 2>/dev/null)" != "$target_uid" ]; then
    chown "$target_uid" "$apps_dir" 2>/dev/null || true
fi
if [ "$where" = "desktop" ] || [ "$where" = "both" ]; then
    mkdir -p "$desk_dir" 2>/dev/null || true
    if [ -d "$desk_dir" ] && [ "$(stat -f %u "$desk_dir" 2>/dev/null)" != "$target_uid" ]; then
        chown "$target_uid" "$desk_dir" 2>/dev/null || true
    fi
fi

safe_slug="$(printf '%s' "$name" | sed 's/[^A-Za-z0-9._+-]/_/g')"
[ -n "$safe_slug" ] || safe_slug="app"

escape_desktop() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

esc_display="$(escape_desktop "$_display")"
esc_icon="$(escape_desktop "$_icon")"
esc_jail="$(escape_desktop "$jail")"
esc_slug="$(escape_desktop "$name")"

entry="[Desktop Entry]
Type=Application
Name=$esc_display
Comment=ParishBSD application in compartment $esc_jail
Exec=/usr/local/bin/parish-app-launch \"$esc_jail\" \"$esc_slug\"
TryExec=/usr/local/bin/parish-app-launch
Icon=$esc_icon
Terminal=false
Categories=Application;
StartupNotify=true"

_install_one() {
    _target="$1"
    _mode="$2"
    _tmp="${_target}.tmp.$$"
    printf '%s\n' "$entry" > "$_tmp"
    chmod "$_mode" "$_tmp"
    if [ "$(id -u)" -eq 0 ] && [ "$target_uid" != "0" ]; then
        if ! chown "$target_uid" "$_tmp" 2>/dev/null; then
            log "warning: cannot chown $_tmp to uid $target_uid"
        fi
    fi
    mv -f "$_tmp" "$_target"
    if [ "$(id -u)" -eq 0 ] && [ "$target_uid" != "0" ]; then
        if ! chown "$target_uid" "$_target" 2>/dev/null; then
            log "warning: cannot chown $_target to uid $target_uid"
        fi
    fi
    printf 'Created: %s\n' "$_target"
}

if [ "$where" = "menu" ] || [ "$where" = "both" ]; then
    _install_one "$apps_dir/parish-$jail-$safe_slug.desktop" 0644
fi
if [ "$where" = "desktop" ] || [ "$where" = "both" ]; then
    _install_one "$desk_dir/parish-$jail-$safe_slug.desktop" 0755
fi

update-desktop-database "$apps_dir" 2>/dev/null || true

printf 'Launcher metadata: %s\n' "$_meta"
exit 0
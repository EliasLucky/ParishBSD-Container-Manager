#!/bin/sh
# parish-apps  manage applications in a compartment.
#
# Usage:
#   parish-apps list <jail>
#   parish-apps install <jail> <package>
#   parish-apps install-file <jail> <file> [--mode=auto|installer|portable]
#                                           [--launcher=menu|desktop|both|none]
#   parish-apps remove <jail> <package>
#   parish-apps remove-custom <jail> <app>
#   parish-apps upgrade <jail> [package]
#   parish-apps launch <jail> <app>
#   parish-apps create-launcher <jail> <name> [where]
#   parish-apps pkg-launcher <jail> <package> [where]
#
# Runs as root (invoked via pkexec from parishctl-apps-<verb>).
#
# LAUNCHER METADATA
# -----------------
# Custom applications' launcher metadata lives host-side at
# /var/db/parishbsd/launchers/<jail>/<slug>.conf (root-owned 0644).
# The format is a header (jail=, slug=, name=, version=, method=,
# install_path=, written_at=) followed by ARGV[n]="..." lines.
#
# The host-side location is not visible to the jail.
#
# Only parish-apps install-file and parish-app-create-launcher write
# to /var/db/parishbsd/launchers/. Any new writer is a design question
# requiring review.
#
# LEGACY IN-JAIL METADATA
# -----------------------
# Pre-rework installs wrote <jailroot>/usr/local/etc/parishbsd/custom-apps/<slug>.conf
# with a LAUNCHER_COMMAND="..." line. That format cannot be safely
# migrated (reading the jail-writable file to write host-side metadata
# would carry the phishing vector forward). Any operation on a
# pre-rework custom app refuses with an instruction to reinstall.
# Migration is reinstall.
#
# EXCHANGE CLEANUP SAFETY
# -----------------------
# The exchange directory holds a temporary copy of the file being
# installed. Cleanup happens on EXIT, INT, TERM. The cleanup is a
# function called via `trap _exchange_cleanup EXIT INT TERM`, not a
# trap string, because the trap string would be built from $base
# (a filename the user chose) and would be shell-interpreted at trap
# fire time. A filename like `foo';id;echo '.pkg` in a trap string
# would execute `id` as root.

set -eu

JAILS_DIR="/usr/local/jails"
EXCHANGE_ROOT="/var/parishbsd/exchange"
LAUNCHER_STORE="/var/db/parishbsd/launchers"
PARISH_BIN=/usr/local/bin
PARISH_APP_CREATE_LAUNCHER=/usr/local/sbin/parish-app-create-launcher
LIBDIR=/usr/local/libexec/parishbsd/lib

. "$LIBDIR/validate.sh"
. "$LIBDIR/desktop.sh"
. "$LIBDIR/launcher.sh"
. "$LIBDIR/container.sh"

log() { printf ' %s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

require_root() {
    [ "$(id -u)" -eq 0 ] || err "must be run as root (invoke via pkexec)"
}

# --------------------------------------------------------------------
# Validation
# --------------------------------------------------------------------

validate_package_name() {
    [ -n "${1-}" ] || err "package name required"
    # reject leading hyphen before the charset check. A package
    # name starting with '-' reaches `pkg install -y "-foo"` and pkg parses it as an option.
    case "$1" in
        -*) err "invalid package name: '$1' (may not start with -)" ;;
    esac
    printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._+-]+$' \
        || err "invalid package name: '$1'"
}

require_jail() {
    validate_jail_name_existing "$1"
    jls name 2>/dev/null | grep -qxF "$1" || err "jail '$1' is not running"
}

canonical_path() {
    local path="$1" real
    real=$(realpath "$path" 2>/dev/null) || err "cannot resolve: $path"
    [ "$real" = "$path" ] || err "not canonical: $path -> $real"
    echo "$real"
}

# _locate_desktop_argv_and_version <jail> <pkg_name>
#
# Sets three globals:
#   _found_exec      Exec= line from the package's .desktop, or empty
#   _found_icon      Icon= line (validated, may be "" on invalid)
#   _found_version   pkg version, or "1.0" fallback
#
# Searches /usr/local/share/applications and /usr/share/applications
# in the jail, matching <pkg_name>.desktop. First match wins.
#
# Used by do_freebsd_pkg (install-file) and cmd_install (catalog).
# Same extraction logic in one place.
_locate_desktop_argv_and_version() {
    _jail="$1"
    _pkg="$2"

    _found_exec=""
    _found_icon=""

    _desktop="$(_find_pkg_desktop "$_jail" "$_pkg")"
    if [ -n "$_desktop" ]; then
        _found_exec="$(jexec "$_jail" sh -c \
            'grep "^Exec=" "$1" | head -1 | cut -d= -f2-' _ "$_desktop")"
        _found_icon="$(jexec "$_jail" sh -c \
            'grep "^Icon=" "$1" | head -1 | cut -d= -f2-' _ "$_desktop")"
    fi

    # Validate icon name; warn and drop if invalid (writer would reject).
    case "$_found_icon" in
        '') : ;;
        */*|*..*)
            log "WARN: icon for $_pkg is a path, using generic"
            _found_icon=""
            ;;
        *[!A-Za-z0-9._+-]*)
            log "WARN: icon for $_pkg has invalid characters, using generic"
            _found_icon=""
            ;;
    esac

    _found_version="$(jexec "$_jail" pkg query %v "$_pkg" 2>/dev/null || echo 1.0)"
}

# --------------------------------------------------------------------
# legacy refusal
# --------------------------------------------------------------------

# refuse_if_legacy_custom_app <jail> <slug>
# Refuses with the two-paragraph message if a pre-rework custom app exists for this slug, in any tier.
refuse_if_legacy_custom_app() {
    _jail="$1"
    _slug="$2"
    for _tier in app vault containers; do
        _legacy="$JAILS_DIR/$_tier/$_jail/usr/local/etc/parishbsd/custom-apps/$_slug.conf"
        if [ -f "$_legacy" ] && [ ! -L "$_legacy" ]; then
            cat >&2 <<EOF
The application "$_slug" in compartment "$_jail" was installed by an
older version of the Compartments Manager. Its launcher metadata is in
a format that cannot be safely used.

Reinstall the application from the Compartments Manager to create a
working launcher. The old "set-launcher" command has been removed; to
change what the application runs, reinstall it with the corrected file.
EOF
            exit 1
        fi
    done
}

# --------------------------------------------------------------------
# Exchange cleanup trap function pattern
# --------------------------------------------------------------------
# The trap is a FUNCTION, not a string. A trap string built from $base
# would be shell-interpreted at fire time; a filename with shell
# metacharacters would execute as root. The function reads globals
# quoted at the call site; no shell interpretation of the values.
#
# Each handler sets _cleanup_jail/_cleanup_base, installs the trap,
# and clears _cleanup_base after explicit cleanup (so a normal exit
# does not re-run cleanup).

_cleanup_jail=""
_cleanup_base=""

_exchange_cleanup() {
    [ -n "$_cleanup_base" ] || return 0
    _saved_jail="$_cleanup_jail"
    _saved_base="$_cleanup_base"
    _cleanup_base=""
    cleanup_exchange "$_saved_jail" "$_saved_base"
}

# --------------------------------------------------------------------
# list
# --------------------------------------------------------------------

cmd_list() {
    jail="${1:?usage: parish-apps list <jail>}"
    validate_jail_name_existing "$jail"

    jailroot="$(container_path "$jail")" || err "no compartment named '$jail'"

    # list works on stopped jails. When the jail is
    # running, `pkg -j <jailname>` uses jexec (matches installed
    # state exactly). When stopped, `pkg -r <jailroot>` reads
    # /var/db/pkg under the jailroot directly (no jexec needed).
    if jls name 2>/dev/null | grep -qxF "$jail"; then
        _pkg_mode="-j"
        _pkg_arg="$jail"
    else
        _pkg_mode="-r"
        _pkg_arg="$jailroot"
    fi
 
    # Native packages
    pkg "$_pkg_mode" "$_pkg_arg" info 2>/dev/null | awk '{
        name = $1
        sub(/-[0-9].*$/, "", name)
        version = $1
        sub(/^.*-/, "", version)
        $1 = ""
        printf "native\t%s\t%s\n", name, version
    }'
 
    # Custom apps (host-side, post-rework)
    launcher_dir="$LAUNCHER_STORE/$jail"
    if [ -d "$launcher_dir" ]; then
        for f in "$launcher_dir"/*.conf; do
            [ -f "$f" ] || continue
            [ ! -L "$f" ] || continue
            name="$(awk -F= '/^name=/{print substr($0, 6); exit}' "$f")"
            version="$(awk -F= '/^version=/{print substr($0, 9); exit}' "$f")"
            method="$(awk -F= '/^method=/{print substr($0, 8); exit}' "$f")"
            printf "custom\t%s\t%s\t%s\n" "${name:-?}" "${version:-?}" "${method:-?}"
        done
    fi
 
    # Legacy in-jail custom apps (pre-rework) display, but flag them
    legacy_dir="$JAILS_DIR/app/$jail/usr/local/etc/parishbsd/custom-apps"
    if [ -d "$legacy_dir" ]; then
        for f in "$legacy_dir"/*.conf; do
            [ -f "$f" ] || continue
            [ ! -L "$f" ] || continue
            name="$(awk -F'"' '/^NAME=/{print $2; exit}' "$f")"
            printf "legacy\t%s\t\t(requires reinstall)\n" "${name:-?}"
        done
    fi
 }

# --------------------------------------------------------------------
# install (from catalog)
# --------------------------------------------------------------------

cmd_install() {
    jail="${1:?usage: parish-apps install <jail> <package>}"
    package="${2:?usage: parish-apps install <jail> <package>}"
    require_jail "$jail"
    parish_require_not_contained "$jail" || exit 1
    validate_package_name "$package"
    log "Installing $package in $jail"
    pkg -j "$jail" install -y "$package" || return $?

    # write host-side metadata immediately after install.
    # Small window (milliseconds) between pkg install and .desktop
    # extraction; attacker must be actively running in the jail at
    # that exact moment.
    _locate_desktop_argv_and_version "$jail" "$package"

    if [ -n "$_found_exec" ]; then
        case "$_found_exec" in
            *[\"\']*|*\\*)
                log "WARN: $package.desktop has quotes or backslashes in Exec=; metadata not written"
                log "To retry later: parishctl apps create-launcher $jail $package"
                return 0
                ;;
        esac
        _cleaned="$(printf '%s' "$_found_exec" | sed 's/%[fFuUdDnNickvm]//g; s/%%/%/g')"
        set -f
        set -- $_cleaned
        set +f
        if [ "$#" -lt 1 ]; then
            log "WARN: $package.desktop has no usable Exec= (only field codes); metadata not written"
            log "To retry later: parishctl apps create-launcher $jail $package"
            return 0
        fi
    else
        set -- "$package"
    fi

    write_host_launcher_metadata "$jail" "$package" "$package" "$_found_version" \
        "freebsd-pkg" "/usr/local" "$_found_icon" "$@"
}

# --------------------------------------------------------------------
# install-file
# --------------------------------------------------------------------

cmd_install_file() {
    jail="${1:?usage: parish-apps install-file <jail> <file> [flags]}"
    shift
    host_file="${1:?usage: parish-apps install-file <jail> <file> [flags]}"
    shift || true
    require_jail "$jail"
    parish_require_not_contained "$jail" || exit 1
    [ -f "$host_file" ] || err "not a regular file: $host_file"
    [ ! -L "$host_file" ] || err "file is a symlink: $host_file"
    canonical_path "$host_file" >/dev/null

    mode="auto"
    launcher="none"
    for arg in "$@"; do
        case "$arg" in
            --mode=installer)   mode="installer" ;;
            --mode=portable)    mode="portable" ;;
            --mode=auto)        mode="auto" ;;
            --launcher=menu)    launcher="menu" ;;
            --launcher=desktop) launcher="desktop" ;;
            --launcher=both)    launcher="both" ;;
            --launcher=none)    launcher="none" ;;
            *)                  err "unknown option: $arg" ;;
        esac
    done

    detected="$("$PARISH_BIN/parish-detect-installer" "$host_file")"
    type_key="${detected%%:*}"
    log "Detected: $detected"

    case "$type_key" in
        windows-exe-ambiguous)
            [ "$mode" = "portable" ]  && type_key="windows-portable-archive"
            [ "$mode" = "installer" ] && type_key="windows-installer"
            ;;
        linux-run-ambiguous)
            [ "$mode" = "portable" ]  && type_key="linux-portable-archive"
            [ "$mode" = "installer" ] && type_key="linux-installer"
            ;;
    esac

    app_name=""
    case "$type_key" in
        freebsd-pkg)              app_name="$(do_freebsd_pkg     "$jail" "$host_file")" ;;
        windows-installer)        app_name="$(do_win_installer   "$jail" "$host_file")" ;;
        windows-portable-archive) app_name="$(do_win_portable    "$jail" "$host_file")" ;;
        linux-portable-archive)   app_name="$(do_linux_portable  "$jail" "$host_file")" ;;
        linux-installer)          app_name="$(do_linux_installer "$jail" "$host_file")" ;;
        unsupported-*)            err "unsupported file type: $detected" ;;
        *)                        err "cannot install this file type: $detected" ;;
    esac

    if [ -n "$app_name" ] && [ "$launcher" != "none" ]; then
        log "Creating launcher for '$app_name' ($launcher)"
        "$PARISH_APP_CREATE_LAUNCHER" "$jail" "$app_name" "$launcher" \
            || log "WARN: launcher creation failed"
    fi

    log "Done"
}

# --------------------------------------------------------------------
# Exchange helpers
# --------------------------------------------------------------------

copy_to_exchange() {
    jail="$1"; file="$2"
    base="$(basename "$file")"
    dest_dir="$(exchange_dir "$jail")"
    mkdir -p "$dest_dir"
    cp -a -P "$file" "$dest_dir/$base"
    chmod 0644 "$dest_dir/$base"
    printf '%s' "$base"
}

cleanup_exchange() {
    jail="$1"; base="$2"
    [ -n "$base" ] || return 0
    rm -f "$(exchange_dir "$jail")/$base" 2>/dev/null || true
}

exchange_dir() {
    jail="$1"
    validate_jail_name_existing "$jail"
    d="$EXCHANGE_ROOT/$jail"
    [ -d "$d" ] || mkdir -p "$d"
    printf '%s' "$d"
}

# --------------------------------------------------------------------
# Install handlers
# --------------------------------------------------------------------

do_freebsd_pkg() {
    jail="$1"; host_file="$2"

    # read the package's own name before install.
    pkg_name="$(pkg query -F "$host_file" %n 2>/dev/null)"
    [ -n "$pkg_name" ] || err "cannot determine package name from $host_file (pkg query -F failed)"
    validate_package_name "$pkg_name"

    base="$(copy_to_exchange "$jail" "$host_file")"
    # trap function, not trap string.
    _cleanup_jail="$jail"
    _cleanup_base="$base"
    trap _exchange_cleanup EXIT INT TERM

    log "Installing FreeBSD package $base ($pkg_name)"
    jexec "$jail" pkg add "/exchange/$base"

    _locate_desktop_argv_and_version "$jail" "$pkg_name"

    cleanup_exchange "$jail" "$base"
    _cleanup_base=""
    trap - EXIT INT TERM

    if [ -n "$_found_exec" ]; then
        case "$_found_exec" in
            *[\"\']*|*\\*)
                err "cannot create launcher: $pkg_name.desktop has quotes or backslashes in its Exec line"
                ;;
        esac
        _cleaned="$(printf '%s' "$_found_exec" | sed 's/%[fFuUdDnNickvm]//g; s/%%/%/g')"
        set -f
        set -- $_cleaned
        set +f
        if [ "$#" -lt 1 ]; then
            err "cannot determine argv from $pkg_name.desktop Exec= line (only field codes present)"
        fi
    else
        set -- "$pkg_name"
    fi

    write_host_launcher_metadata "$jail" "$pkg_name" "$pkg_name" "$_found_version" \
        "freebsd-pkg" "/usr/local" "$_found_icon" "$@"
    log "Package installed"
    printf '%s' "$pkg_name"
}

do_win_installer() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    # trap function.
    _cleanup_jail="$jail"
    _cleanup_base="$base"
    trap _exchange_cleanup EXIT INT TERM

    log "Running Windows installer $base (Wine)"
    jexec "$jail" wine "/exchange/$base"

    exe="$(jexec "$jail" sh -c '
        find /root/.wine/drive_c -name "*.exe" -type f \
            -not -path "*windows*" 2>/dev/null \
            | xargs ls -t 2>/dev/null | head -1
    ')"

    stem="$(printf '%s\n' "$base" | sed 's/\.[^.]*$//; s/-[Ss]etup$//; s/[Ss]etup$//')"

    cleanup_exchange "$jail" "$base"
    _cleanup_base=""
    trap - EXIT INT TERM

    if [ -z "$exe" ]; then
        log "WARN: no .exe found after installer; metadata not written"
        log "You can still launch the app from a console."
        return 0
    fi

    write_host_launcher_metadata "$jail" "$stem" "$stem" "1.0" \
        "wine-installer" "$(dirname "$exe")" "" "wine" "$exe"
    log "Installer finished; main program at $exe"
    printf '%s' "$stem"
}

do_win_portable() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    # trap function.
    _cleanup_jail="$jail"
    _cleanup_base="$base"
    trap _exchange_cleanup EXIT INT TERM

    stem="$(printf '%s' "$base" | sed 's/\.[^.]*$//')"
    install_dir="/opt/parish-apps/$stem"

    log "Extracting to $install_dir inside $jail"

    jexec "$jail" sh -c '
        set -eu
        mkdir -p "$1"
        cd "$1"
        case "$2" in
            *.zip)           unzip -q "/exchange/$2" ;;
            *.tar.gz|*.tgz)  tar -xzf "/exchange/$2" ;;
            *.tar.xz)        tar -xJf "/exchange/$2" ;;
            *.tar.bz2)       tar -xjf "/exchange/$2" ;;
            *) echo "unsupported archive"; exit 1 ;;
        esac
    ' _ "$install_dir" "$base"

    exe="$(jexec "$jail" find "$install_dir" -maxdepth 3 -name '*.exe' \
            -type f 2>/dev/null | head -1)"

    cleanup_exchange "$jail" "$base"
    _cleanup_base=""
    trap - EXIT INT TERM

    # match do_win_installer WARN and skip, do not write
    # metadata with wine pointing at a directory.
    if [ -z "$exe" ]; then
        log "WARN: no .exe found in $install_dir; metadata not written"
        log "You can still launch the app from a console."
        return 0
    fi

    write_host_launcher_metadata "$jail" "$stem" "$stem" "1.0" \
        "wine-portable" "$install_dir" "" "wine" "$exe"
    log "Portable application installed at $install_dir"
    printf '%s' "$stem"
}

do_linux_portable() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    # trap function.
    _cleanup_jail="$jail"
    _cleanup_base="$base"
    trap _exchange_cleanup EXIT INT TERM

    stem="$(printf '%s' "$base" | sed 's/\.[^.]*$//')"
    install_dir="/opt/parish-apps/$stem"

    log "Extracting to $install_dir inside $jail"

    jexec "$jail" sh -c '
        set -eu
        mkdir -p "$1"
        cd "$1"
        case "$2" in
            *.zip)           unzip -q "/exchange/$2" ;;
            *.tar.gz|*.tgz)  tar -xzf "/exchange/$2" ;;
            *.tar.xz)        tar -xJf "/exchange/$2" ;;
            *.tar.bz2)       tar -xjf "/exchange/$2" ;;
            *) echo "unsupported archive"; exit 1 ;;
        esac
        chmod +x bin/* usr/bin/* 2>/dev/null || true
    ' _ "$install_dir" "$base"

    binary="$(jexec "$jail" sh -c '
        for candidate in "$1/$2" "$1/bin/$2" "$1/usr/bin/$2"; do
            [ -x "$candidate" ] && echo "$candidate" && exit 0
        done
        [ -d "$1/bin" ] && find "$1/bin" -maxdepth 1 -type f -perm -u+x | head -1
    ' _ "$install_dir" "$stem")"

    cleanup_exchange "$jail" "$base"
    _cleanup_base=""
    trap - EXIT INT TERM

    # write_host_launcher_metadata rejects any argv element containing
    # '"', and the fallback's literal argument contained quotes. Match
    # do_win_installer: WARN and skip.
    if [ -z "$binary" ]; then
        log "WARN: no executable found in $install_dir; metadata not written"
        log "You can still launch the app from a console."
        return 0
    fi

    write_host_launcher_metadata "$jail" "$stem" "$stem" "1.0" \
        "linux-portable" "$install_dir" "" "$binary"
    log "Portable application installed at $install_dir"
    printf '%s' "$stem"
}

do_linux_installer() {
    jail="$1"; host_file="$2"
    base="$(copy_to_exchange "$jail" "$host_file")"
    # trap function.
    _cleanup_jail="$jail"
    _cleanup_base="$base"
    trap _exchange_cleanup EXIT INT TERM

    log "Running Linux installer $base"

    if ! jexec "$jail" sh -c '[ -x "/exchange/$1" ] && "/exchange/$1"' _ "$base"; then
        jexec "$jail" /compat/linux/bin/sh "/exchange/$base"
    fi

    stem="$(printf '%s\n' "$base" | sed 's/\.[^.]*$//; s/-[Ii]nstall.*//')"

    install_dir="/opt/$stem"
    jexec "$jail" test -d "/opt/$stem" || install_dir="/usr/local/$stem"
    jexec "$jail" test -d "$install_dir" || install_dir=""

    cleanup_exchange "$jail" "$base"
    _cleanup_base=""
    trap - EXIT INT TERM

    if [ -z "$install_dir" ]; then
        log "WARN: could not locate install directory for $stem; metadata not written"
        log "You can still launch the app from a console."
        printf ''
        return 0
    fi

    # locate the executable INSIDE install_dir.
    exe="$(jexec "$jail" sh -c '
        for candidate in "$1/$2" "$1/bin/$2" "$1/usr/bin/$2"; do
            [ -x "$candidate" ] && echo "$candidate" && exit 0
        done
        [ -d "$1/bin" ] && find "$1/bin" -maxdepth 1 -type f -perm -u+x | head -1
    ' _ "$install_dir" "$stem")"

    if [ -z "$exe" ]; then
        log "WARN: no executable found in $install_dir; metadata not written"
        log "You can still launch the app from a console."
        printf ''
        return 0
    fi

    write_host_launcher_metadata "$jail" "$stem" "$stem" "1.0" \
        "linux-installer" "$install_dir" "" "$exe"
    log "Installer finished"
    printf '%s' "$stem"
}

# --------------------------------------------------------------------
# remove / remove-custom / upgrade
# --------------------------------------------------------------------

cmd_remove() {
    jail="${1:?usage: parish-apps remove <jail> <package>}"
    package="${2:?usage: parish-apps remove <jail> <package>}"
    require_jail "$jail"
    parish_require_not_contained "$jail" || exit 1
    validate_package_name "$package"
    log "Removing $package from $jail"
    pkg -j "$jail" delete -y "$package"
}

cmd_remove_custom() {
    jail="${1:?usage: parish-apps remove-custom <jail> <app>}"
    app_name="${2:?usage: parish-apps remove-custom <jail> <app>}"
    validate_app_name "$app_name" || err "invalid app name: $app_name"
    parish_require_not_contained "$jail" || exit 1

    _removed=0

    # Host-side metadata (post-rework).
    _meta="$LAUNCHER_STORE/$jail/$app_name.conf"
    if [ -f "$_meta" ] && [ ! -L "$_meta" ]; then
        rm -f "$_meta"
        _removed=1
    fi

    # Unlink legacy metadata by name (no read, so the
    # reading jail-writable content does not apply). Three-tier scan matches refuse_if_legacy_custom_app.
    for _tier in app vault containers; do
        _legacy="$JAILS_DIR/$_tier/$jail/usr/local/etc/parishbsd/custom-apps/$app_name.conf"
        if [ -f "$_legacy" ] && [ ! -L "$_legacy" ]; then
            rm -f "$_legacy"
            log "Removed legacy metadata for $app_name ($_tier tier)"
            _removed=1
        fi
    done

    [ "$_removed" -eq 1 ] || err "no metadata found for '$app_name'"

    log "Note: installed files under /opt/parish-apps/ were not removed."
}

cmd_upgrade() {
    jail="${1:?usage: parish-apps upgrade <jail> [package]}"
    package="${2:-}"
    require_jail "$jail"
    parish_require_not_contained "$jail" || exit 1

    if [ -n "$package" ]; then
        validate_package_name "$package"
        log "Upgrading $package in $jail"
        pkg -j "$jail" upgrade -y "$package"
    else
        log "Upgrading all packages in $jail"
        pkg -j "$jail" upgrade -y
    fi
}

# --------------------------------------------------------------------
# launch / create-launcher / pkg-launcher
# --------------------------------------------------------------------

cmd_launch() {
    jail="${1:?usage: parish-apps launch <jail> <app>}"
    app="${2:?usage: parish-apps launch <jail> <app>}"
    validate_app_name "$app" || err "invalid app name: $app"
    parish_require_not_contained "$jail" || exit 1
    exec "$PARISH_BIN/parish-app-launch" "$jail" "$app"
}

cmd_create_launcher() {
    jail="${1:?usage: parish-apps create-launcher <jail> <name> [where]}"
    name="${2:?}"
    where="${3:-menu}"
    validate_app_name "$name" || err "invalid app name: $name"
    parish_require_not_contained "$jail" || exit 1
    # create-launcher's refusal is intentional (the user is trying to
    # install/configure; legacy presence means they must reinstall to
    # migrate).
    refuse_if_legacy_custom_app "$jail" "$name"
    exec "$PARISH_APP_CREATE_LAUNCHER" "$jail" "$name" "$where"
}

cmd_pkg_launcher() {
    jail="${1:?usage: parish-apps pkg-launcher <jail> <package> [where]}"
    package="${2:?}"
    where="${3:-menu}"
    validate_package_name "$package"
    parish_require_not_contained "$jail" || exit 1
    exec "$PARISH_APP_CREATE_LAUNCHER" "$jail" "$package" "$where"
}

# --------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------

require_root

cmd="${1:-}"; shift || true
case "$cmd" in
    list)            cmd_list            "$@" ;;
    install)         cmd_install         "$@" ;;
    install-file)    cmd_install_file    "$@" ;;
    remove)          cmd_remove          "$@" ;;
    remove-custom)   cmd_remove_custom   "$@" ;;
    upgrade)         cmd_upgrade         "$@" ;;
    launch)          cmd_launch          "$@" ;;
    create-launcher) cmd_create_launcher "$@" ;;
    pkg-launcher)    cmd_pkg_launcher    "$@" ;;
    *)
        err "usage: parish-apps {list|install|install-file|remove|remove-custom|upgrade|launch|create-launcher|pkg-launcher} ..."
        ;;
esac
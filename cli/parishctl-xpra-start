#!/bin/sh
# parishctl-xpra-start  start Xpra for a compartment.
#
# Runs via pkexec. Polkit action .xpra-start with auth_admin_keep
# (routine; reversible by `parish-xpra` session end / stop).
#
# Requires the compartment to be running. Refuses with the state
# message otherwise (matches parishctl-start's dispatch).
#
# Forwards to `parish-xpra start`, which starts the Xpra server
# inside the jail. If Xpra is already running
# for this jail, `parish-xpra start` no-ops.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -ne 1 ]; then
    printf 'usage: parishctl-xpra-start <jail>\n' >&2
    exit 2
fi

jail="$1"
validate_jail_name_existing "$jail" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained)
        : # proceed
        ;;
    stopped)
        printf 'parishctl: compartment "%s" is not running. Start it first.\n' "$jail" >&2
        exit 1
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

exec /usr/local/bin/parish-xpra start "$jail"
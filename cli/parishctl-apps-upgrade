#!/bin/sh
# parishctl-apps-upgrade  upgrade packages in a compartment.
#
# Runs via pkexec. Polkit action .apps-upgrade at auth_admin_keep.
#
# Two forms:
#   parishctl apps upgrade <jail>            upgrade all packages
#   parishctl apps upgrade <jail> <package>  upgrade one package
#
# Refuses on containment states.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"
. "$LIBDIR/state.sh"

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    printf 'usage: parishctl apps upgrade <jail> [package]\n' >&2
    exit 2
fi

jail="$1"
package="${2-}"

validate_jail_name_existing "$jail" || exit 2
[ -z "$package" ] || validate_package_name "$package" || exit 2

state="$(parish_jail_state "$jail")"
case "$state" in
    running|running-other-contained)
        : # proceed
        ;;
    stopped)
        printf 'parishctl: compartment "%s" is not running.\n' "$jail" >&2
        printf 'Start it first:\n  pkexec parishctl-start %s\n' "$jail" >&2
        exit 1
        ;;
    *)
        parish_jail_state_message "$jail" "$state" >&2
        exit 1
        ;;
esac

if [ -z "$package" ]; then
    exec /usr/local/bin/parish-apps upgrade "$jail"
else
    exec /usr/local/bin/parish-apps upgrade "$jail" "$package"
fi
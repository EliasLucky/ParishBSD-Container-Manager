#!/bin/sh
# parishctl-unschedule-lock - remove a scheduled lock.
#
# Runs via pkexec. Polkit action .unschedule-lock at auth_admin_keep.

set -eu

LIBDIR=/usr/local/libexec/parishbsd/lib
. "$LIBDIR/validate.sh"

if [ "$#" -ne 1 ]; then
    printf 'usage: parishctl unschedule-lock <vault>\n' >&2
    exit 2
fi

name="$1"
validate_jail_name_existing "$name" || exit 2

cfg=/usr/local/etc/parishbsd/lock-schedules

if [ ! -f "$cfg" ] || \
   ! awk -v n="$name" '$1 "" == n {found=1; exit} END{exit !found}' "$cfg"; then
    printf 'parishctl: no schedule exists for "%s"\n' "$name" >&2
    exit 1
fi

exec 9> "$cfg.lock" || { printf 'parishctl: cannot open %s.lock\n' "$cfg" >&2; exit 1; }
lockf -t 30 9 || { exec 9>&-; printf 'parishctl: could not acquire schedules lock\n' >&2; exit 1; }

_tmp="$cfg.tmpl.$$"
awk -v n="$name" '$1 "" != n' "$cfg" > "$_tmp" \
    || { rm -f "$_tmp"; exec 9>&-; printf 'parishctl: failed to update %s\n' "$cfg" >&2; exit 1; }
chmod 0600 "$_tmp" || { rm -f "$_tmp"; exec 9>&-; printf 'parishctl: cannot chmod %s\n' "$_tmp" >&2; exit 1; }
mv "$_tmp" "$cfg" || { rm -f "$_tmp"; exec 9>&-; printf 'parishctl: cannot rename %s\n' "$_tmp" >&2; exit 1; }
exec 9>&-

printf 'Removed schedule for "%s".\n' "$name"
